# apps/web: the NYC-MON product and promo site. Payload, its admin and Better
# Auth run in apps/admin-vite (docs/adr/0003-admin-app-split.md), so this app
# holds no database or auth secrets. Prefer the workspace root .env.
# Public origin of this site, no trailing slash. Read once by lib/site-url.ts
# for metadataBase, canonical URLs, Open Graph image URLs, robots.txt and the
# sitemap. Set it to the production origin in the hosting env; unset or
# invalid falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production builds 404 the template app screens (/explore, /profile, /settings,
# /schedule, /notifications) that show demo data. Set to 1 only on a private
# preview deployment that needs them (lib/app-preview.ts). Build-time: set it
# before `next build`, not only in the runtime environment.
# NYCMON_APP_PREVIEW=1
