{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "22.13.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_VD_CELL_BASE": "https://city-assets.nyc-mon.city/releases/r20261030-c98106d6" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "env": { "EXPO_PUBLIC_VD_CELL_BASE": "https://city-assets.nyc-mon.city/releases/r20261030-c98106d6" }
    }
  },
  "submit": {
    "production": {}
  }
}
