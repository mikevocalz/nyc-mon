{
  "name": "mobile",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/assert-viro-fork.mjs && expo start",
    "android": "node scripts/assert-viro-fork.mjs && expo run:android",
    "android:quest": "node scripts/assert-viro-fork.mjs && expo run:android --variant questDebug",
    "quest": "node scripts/assert-viro-fork.mjs && expo prebuild --platform android --clean --no-install && node ../../tooling/verify-spatial-android.mjs && cd android && ./gradlew :app:assembleQuestDebug --no-daemon && node ../../../tooling/verify-spatial-android.mjs --quest-manifest",
    "ios": "node scripts/assert-viro-fork.mjs && expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "viro:assert-fork": "node scripts/assert-viro-fork.mjs",
    "prebuild": "node scripts/assert-viro-fork.mjs && expo prebuild"
  },
  "dependencies": {
    "@acme/app": "workspace:*",
    "@acme/spatial": "workspace:*",
    "@acme/theme": "workspace:*",
    "@acme/ui": "workspace:*",
    "@expo-pico/core": "github:mikevocalz/expo-pico#release/core",
    "@expo-pico/platform-service-common": "github:mikevocalz/expo-pico#release/platform-service-common",
    "@expo/dom-webview": "catalog:",
    "@expo/env": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@expo/ui": "catalog:",
    "@metavr/layout-compat": "catalog:",
    "@metavr/layout-window-compat": "catalog:",
    "@react-navigation/native": "catalog:",
    "@reactvision/react-viro": "catalog:",
    "@rive-app/react-native": "catalog:",
    "@tanstack/react-pacer": "catalog:",
    "@tanstack/react-query": "catalog:",
    "canvaskit-wasm": "catalog:",
    "expo": "catalog:",
    "expo-asset": "catalog:",
    "expo-build-properties": "catalog:",
    "expo-calendar": "catalog:",
    "expo-constants": "catalog:",
    "expo-drag-drop-content-view": "catalog:",
    "expo-font": "catalog:",
    "expo-horizon-core": "github:mikevocalz/expo-pico#release/horizon-core",
    "expo-image": "catalog:",
    "expo-linking": "catalog:",
    "expo-notifications": "catalog:",
    "expo-paste-input": "catalog:",
    "expo-router": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "lucide-react-native": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-audio-api": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-keyboard-controller": "catalog:",
    "react-native-mmkv": "catalog:",
    "react-native-nitro-modules": "catalog:",
    "react-native-pulsar": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-skia": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "react-native-webgpu": "catalog:",
    "react-native-worklets": "catalog:",
    "solito": "catalog:",
    "uniwind": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@react-native/metro-config": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/react": "catalog:",
    "babel-preset-expo": "catalog:",
    "eslint": "catalog:",
    "eslint-config-expo": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    },
    "autolinking": {
      "nativeModulesDir": "../../packages/ui/modules",
      "searchPaths": [
        "./modules"
      ]
    }
  }
}
