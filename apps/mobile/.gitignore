*.tsbuildinfo

app-example

# Continuous Native Generation: android/ and ios/ are regenerated by
# `expo prebuild` from app.config.ts and the config plugins. Nothing in them
# is hand-written (VRActivity, MainApplication's Viro packages and the
# quest/pico flavor manifests all come from plugins).
/android
/ios
