{
  "extends": "@acme/config/typescript/react-library.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    // src/routes/_payload/importMap.js is generated by Payload without types.
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "@payload-config": ["../../packages/payload/src/payload.config.ts"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist", ".tanstack", ".output", ".vercel"]
}
