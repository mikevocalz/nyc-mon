{
  "name": "nyc-mon",
  "version": "0.1.0",
  "private": true,
  "description": "NYC Mon — Expo SDK 58 + Next.js + Skia + Viro Web/OpenXR + Rive universal spatial starter.",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.15.0 <26"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "gen": "node tooling/generators/gen.mjs",
    "spatial:prepare-web": "node tooling/copy-viro-web-assets.mjs",
    "skia:prepare-web": "node tooling/copy-skia-web-assets.mjs",
    "postinstall": "node tooling/copy-viro-web-assets.mjs && node tooling/copy-skia-web-assets.mjs",
    "spatial:verify-android": "node tooling/verify-spatial-android.mjs",
    "spatial:verify-typegpu": "node tooling/verify-typegpu-toolchain.mjs",
    "site-qa:shots": "node tooling/site-qa/shots.mjs",
    "site-qa:axe": "node tooling/site-qa/axe.mjs",
    "site-qa:copy-lint": "node tooling/site-qa/copy-lint.mjs",
    "site-qa:motion": "node tooling/site-qa/motion.mjs",
    "site-qa:backnav": "node tooling/site-qa/backnav.mjs",
    "site-qa:lhci": "node tooling/site-qa/lhci.mjs",
    "site-qa:all": "node tooling/site-qa/all.mjs",
    "perf:tracesift:init": "npx --yes @callstack/tracesift@0.4.0 init",
    "perf:tracesift": "npx --yes @callstack/tracesift@0.4.0 start"
  },
  "devDependencies": {
    "axe-core": "4.11.0",
    "lighthouse": "13.5.0",
    "playwright": "1.63.0",
    "turbo": "catalog:"
  }
}
