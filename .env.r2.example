# Cloudflare R2 publish credentials for tooling/city/r2-publish.mjs.
# Copy to .env.r2 and fill in — .env.r2 is gitignored; never commit real values.

# Cloudflare account id (dashboard, right sidebar).
R2_ACCOUNT_ID=
# Bucket to publish into. Prod: nyc-mon-valdrada-prod. Staging: nyc-mon-valdrada-staging.
R2_BUCKET_NAME=
# An R2 API token's access key / secret (R2 -> Manage API tokens; object read+write on the bucket).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: override the S3 endpoint (default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com).
# Point at a local S3-compatible target for offline tests; staging uses the same endpoint with the staging bucket.
R2_ENDPOINT=

# Optional: pin a release id (default r<yyyymmdd UTC>-<manifest sha8>).
VD_RELEASE_ID=

# Public read base the cell source fetches under (EXPO_PUBLIC_VD_CELL_BASE) and r2-verify.mjs checks.
R2_PUBLIC_BASE_URL=https://city-assets.nyc-mon.city/releases/current/
# Staging r2.dev endpoint (no pointer resolution — serve paths literally, so aim at a release prefix):
# R2_PUBLIC_BASE_URL=https://pub-8272e2d358874d0580d90a49b1bede7d.r2.dev/releases/r20261030-0123abcd/
