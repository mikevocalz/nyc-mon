# Workspace env loaded by all apps.
# Keep secrets in local .env / hosting provider env, never in git.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_APP_URL=http://localhost:3000

# Payload (server-only). Read by apps/admin-vite, which hosts the admin at
# /admin and the REST API at /payload-api (docs/adr/0003-admin-app-split.md).
PAYLOAD_SECRET=generate-a-long-random-string
PAYLOAD_PUSH=false
DATABASE_URL=postgresql://user:pass@localhost:5432/starter

# Auth: Better Auth on Payload (docs/adr/0001-auth-and-identity.md). Server-only.
# Origin of apps/admin-vite, where Better Auth is mounted at /payload-api/auth.
# Links, cookies and passkeys are issued for this origin. Defaults to the
# admin-vite dev server.
BETTER_AUTH_URL=http://localhost:5174
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Extra trusted origins, comma-separated (Expo scheme, preview hosts).
BETTER_AUTH_TRUSTED_ORIGINS=
# Resend (DECISIONS #3). Without both, reset and verification mail stay off.
RESEND_API_KEY=
# Sender on a Resend-verified domain, e.g. NYC-MON <hello@your-domain>
AUTH_EMAIL_FROM=
# Keep false until Resend sends from a verified domain here. true without
# RESEND_API_KEY and AUTH_EMAIL_FROM fails the boot on purpose (lockout guard).
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# SMS for phone verification and two-factor codes (docs/adr/0004-auth-methods-and-device-handoff.md §6).
# sns = AWS SNS; console = print codes to the server log (refused when NODE_ENV=production).
# Unset = no SMS: the phone-number plugin is not mounted and codes go by email.
AUTH_SMS_TRANSPORT=
# Comma-separated ISO country codes. Only US and CA are supported (DECISIONS #19).
AUTH_SMS_ALLOWED_COUNTRIES=US,CA
# AWS SNS, server-only. Keys can be replaced by the Vercel AWS integration's role.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Registered toll-free or 10DLC number in E.164, e.g. +18885550100
AWS_SNS_ORIGINATION_NUMBER=
# Headset and tablet client ids allowed to request a device code (ADR 0004 §9).
AUTH_DEVICE_CLIENT_IDS=nyc-mon-quest,nyc-mon-visionos,nyc-mon-tablet

# Sign in with Google / Apple. A provider is enabled only when its id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# ReactVision / Viro co-location.
# These are client-side project credentials used by the Viro room + replication APIs.
EXPO_PUBLIC_REACTVISION_API_KEY=
EXPO_PUBLIC_REACTVISION_PROJECT_ID=
EXPO_PUBLIC_REACTVISION_ENDPOINT=https://platform.reactvision.xyz
# Optional live pose/replication relay override. Leave blank for Viro's production default.
EXPO_PUBLIC_REACTVISION_RELAY_ENDPOINT=

# Meta Quest app identity used by Horizon OS overlays / VRActivity.
EXPO_PUBLIC_META_QUEST_APP_ID=

# Neon Postgres (production)
# DATABASE_URL is the Neon pooled/direct Postgres connection string.
# Keep the Payload schema isolated with schemaName: 'payload'.

# Bunny Storage + CDN (production media; never expose the storage password to clients)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_REGION=
BUNNY_CDN_URL=

# Waitlist (PS-001). Server-only base URL of apps/admin-vite; the web server action posts to ${ADMIN_API_URL}/v1/waitlist.
ADMIN_API_URL=http://localhost:5174
# Shared with apps/admin-vite; lets it trust the visitor IP the web server action forwards. openssl rand -base64 32
WAITLIST_FORWARD_SECRET=

# Alexa+ account linking: the OAuth authorization server in admin-vite (ADR 0016, docs/alexa/AUTH.md).
# Issuer origin for tokens and RFC 8414 metadata; defaults to the BETTER_AUTH_URL origin. The MCP server reads the same name.
AUTH_ISSUER=
# Canonical MCP server URI. Must match MCP_RESOURCE_URI in packages/mcp-server and the add-on manifest byte for byte.
MCP_RESOURCE_URI=http://localhost:8788/mcp
# Static client for Alexa. Registered only when the secret and redirect URIs are both set. The redirect URIs are the ones `alexa-ai configure-account-linking` prints (comma-separated, https).
OAUTH_ALEXA_CLIENT_ID=alexa
OAUTH_ALEXA_CLIENT_SECRET=
OAUTH_ALEXA_REDIRECT_URIS=
# Static client for the web simulator. Without a secret it is a public client (PKCE only, no client_credentials).
OAUTH_SIM_CLIENT_ID=nyc-mon-sim
OAUTH_SIM_CLIENT_SECRET=
OAUTH_SIM_REDIRECT_URIS=http://localhost:5180/oauth/callback

# MCP server (packages/mcp-server, docs/alexa/AUTH.md). Shared secret, 32+ characters, set to the same value in admin-vite:
# the MCP server calls /v1 on a user's behalf with it. Generate with `openssl rand -base64 32`.
V1_MCP_SERVICE_KEY=
# How the MCP server checks access tokens: jwt (default, against AUTH_JWKS_URL) or introspection.
MCP_TOKEN_VERIFIER=
# JWKS of the authorization server; defaults to {AUTH_ISSUER}/payload-api/auth/jwks.
AUTH_JWKS_URL=
# Comma-separated browser origins allowed to call /mcp. The web simulator needs http://localhost:5180 locally.
MCP_ALLOWED_ORIGINS=
# Local development only; the server refuses both in production.
MCP_DEV_MODE=
OAUTH_DEV_BYPASS=

# Web simulator (packages/web-sim, docs/alexa/SIMULATOR.md). Defaults suit local dev.
SIM_MCP_URL=
SIM_PUBLIC_ORIGIN=
SIM_SANDBOX_ORIGIN=
# oauth (default) or dev-bypass; dev-bypass needs OAUTH_DEV_BYPASS=1 on the MCP server.
SIM_AUTH_MODE=
SIM_DEV_MODE=
# bedrock (default) or mock. Bedrock uses the standard AWS credential chain; never put AWS keys in this file.
SIM_MODEL_BACKEND=
SIM_BEDROCK_MODEL_ID=
SIM_BEDROCK_REGION=
