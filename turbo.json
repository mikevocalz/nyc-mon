{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "../../.env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "storybook-static/**"
      ]
    },
    "@acme/theme#build": {
      "outputs": [
        "theme.css",
        "theme-native.css"
      ]
    },
    "web#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "../../.env*",
        "../../packages/ui/**",
        "../../packages/app/**",
        "../../packages/theme/**"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NYCMON_SITE_EDITOR",
        "SITE_CONTENT_MODE",
        "PAYLOAD_SITE_API_URL",
        "SITE_EMBED_ORIGINS",
        "SITE_PREVIEW_SECRET"
      ]
    },
    "storybook#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../.env*",
        "../../packages/ui/**",
        "../../packages/app/**",
        "../../packages/theme/**"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
