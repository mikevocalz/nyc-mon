+/**
+ * Payload's base `APIError` and better-call's `APIError` share the name
+ * "APIError", and better-call's `isAPIError` matches on the name. When a
+ * Payload APIError escapes an adapter method, better-call renders it as its
+ * own: `status` comes from `statusCode` (absent on Payload's, so the Response
+ * defaults to 200), `statusText` from `status.toString()` (Payload's numeric
+ * 500 becomes "500") and the body from `body` (absent, so empty). The request
+ * answers `200 500` with no body and nothing is logged.
+ *
+ * Rethrow it as a plain Error so better-call takes its unknown-error path:
+ * it logs `# SERVER_ERROR:` with the cause and answers a real 500.
+ */ function toAdapterError(method, model, error) {
+    if (error instanceof Error && error.name === 'APIError' && typeof error.statusCode !== 'number') {
+        return new Error(`[payload-adapter] ${method} on '${model}' failed: ${error.message}`, {
+            cause: error
+        });
+    }
+    return error;
+}
+function withPayloadErrorTranslation(methods) {
+    const wrapped = {};
+    for (const [method, fn] of Object.entries(methods)){
+        wrapped[method] = async (args)=>{
+            try {
+                return await fn(args);
+            } catch (error) {
+                throw toAdapterError(method, args?.model, error);
+            }
+        };
+    }
+    return wrapped;
+}
