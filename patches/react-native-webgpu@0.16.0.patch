+template <typename Class>
+bool installConstructorOn(jsi::Runtime &runtime, bool onlyMissing) {
+  if (onlyMissing && runtime.global().hasProperty(runtime, Class::CLASS_NAME)) {
+    return false;
+  }
+  Class::installConstructor(runtime);
+  return true;
