+
+// The comma fold runs the installs in list order.
+template <typename... Classes>
+size_t installConstructorsOn(jsi::Runtime &runtime, bool onlyMissing) {
+  size_t installed = 0;
+  ((installed += installConstructorOn<Classes>(runtime, onlyMissing) ? 1 : 0),
+   ...);
+  return installed;
+}
