diff --git a/android/react_viro/build.gradle b/android/react_viro/build.gradle
index a117c4d641d80813724e251b12b564af6b78db74..ed7c9ea9c93ba6ff4c8a85f573428c2e09bf8535 100644
--- a/android/react_viro/build.gradle
+++ b/android/react_viro/build.gradle
@@ -23,6 +23,8 @@ dependencies {
 // Same AGP 8.12+ bundleAar guard as viro_renderer — see that build.gradle.
 afterEvaluate {
     tasks.matching {
-        it.name.startsWith('bundle') && it.name.endsWith('Aar')
+        // Not the *LocalLintAar tasks: release lint (lintVitalAnalyze*) reads
+        // their output, and AGP's local-aar check only applies to publishing.
+        it.name.startsWith('bundle') && it.name.endsWith('Aar') && !it.name.endsWith('LocalLintAar')
     }.configureEach { enabled = false }
 }
diff --git a/android/viro_renderer/build.gradle b/android/viro_renderer/build.gradle
index 21c54d67216c96ea6dcf9c7a8209b9391ea9fc0d..05eb5f460ce2d6fe911fbcbb54b089ad32bc3262 100644
--- a/android/viro_renderer/build.gradle
+++ b/android/viro_renderer/build.gradle
@@ -6,6 +6,9 @@ android {
 
     defaultConfig {
         minSdkVersion rootProject.ext.minSdkVersion
+        // R8 rules for classes the prebuilt AARs reference but don't ship (GVR's
+        // protobuf logging, one Viro scan callback). Release minify fails without them.
+        consumerProguardFiles 'consumer-rules.pro'
     }
 
     flavorDimensions += "device"
@@ -26,6 +29,8 @@ dependencies {
 // task for every variant. Fixes 'hasLocalAarDeps' evaluation failure.
 afterEvaluate {
     tasks.matching {
-        it.name.startsWith('bundle') && it.name.endsWith('Aar')
+        // Not the *LocalLintAar tasks: release lint (lintVitalAnalyze*) reads
+        // their output, and AGP's local-aar check only applies to publishing.
+        it.name.startsWith('bundle') && it.name.endsWith('Aar') && !it.name.endsWith('LocalLintAar')
     }.configureEach { enabled = false }
 }
