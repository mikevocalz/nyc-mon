+		// shadows broke into patches that changed with camera distance.
+		const shadowPosition = vec4( shadowPositionWorld.add( normalWorldGeometry.mul( normalBias ) ), 1 ).toVar();
 		const viewDepth = positionView.z.negate().toVar();
 
 		const shadowValue = float( 1 ).toVar( 'shadowValue' );
