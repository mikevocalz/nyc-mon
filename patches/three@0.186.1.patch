diff --git a/build/three.webgpu.js b/build/three.webgpu.js
index 48b30e6bf4bf114ba5524ae509c81c4a043d27ea..253c22d93ba94783e56f735a9bb4a12ae3d6cac8 100644
--- a/build/three.webgpu.js
+++ b/build/three.webgpu.js
@@ -40755,7 +40755,11 @@ const attributeArray = ( count, type = 'float' ) => {
 	}
 
 	const buffer = new StorageBufferAttribute( count, itemSize, typedArray );
-	const node = storage( buffer, type, count );
+	// nyc-mon patch: buffer.count, as instancedArray does. Passing `count` through
+	// hands a TypedArray argument to StorageBufferNode as its bufferCount, and
+	// WGSLNodeBuilder.getUniforms then coerces it with `bufferCount > 0`, joining
+	// every element into a string once per shader stage.
+	const node = storage( buffer, type, buffer.count );
 
 	return node;
 
