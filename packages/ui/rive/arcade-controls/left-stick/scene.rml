                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="560" y="0" animationId="0:722" reset="true" id="0:732">
                    <StateTransition stateToId="0:730" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                    <StateTransition stateToId="0:731" duration="80">
