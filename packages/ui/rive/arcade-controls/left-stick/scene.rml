                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="360" y="-100" animationId="0:721" id="0:731">
                    <StateTransition stateToId="0:732" duration="0">
                        <TransitionViewModelCondition>
