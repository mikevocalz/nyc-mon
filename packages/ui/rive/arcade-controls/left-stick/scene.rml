        <FormulaTokenOperation operationType="1"/>
        <FormulaTokenInput/>
        <FormulaTokenArgumentSeparator/>
        <FormulaTokenValue operationValue="0"/>
        <FormulaTokenOperation operationType="1"/>
        <FormulaTokenValue><DataBindContext sourcePathIds="0:40-0:45-0:53" propertyKey="777"/></FormulaTokenValue>
        <FormulaTokenParenthesisClose/>
    </DataConverterFormula>
    <DataConverterFormula name="MinNegXY" id="0:125">
