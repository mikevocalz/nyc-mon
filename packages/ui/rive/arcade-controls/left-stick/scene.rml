                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- highlight counter-slides: light stays top-left as the pad tilts -->
    <DataConverterRangeMapper minInput="-1" maxInput="1" minOutput="-1" maxOutput="-11"
                              clampLower="true" clampUpper="true" name="HighlightX" id="0:116"/>
    <DataConverterRangeMapper minInput="-1" maxInput="1" minOutput="-12" maxOutput="-2"
                              clampLower="true" clampUpper="true" name="HighlightY" id="0:117"/>

    <!-- Indicator lighting. A cardinal tick reads its own axis: 0.5..1 of
         travel maps to opacity 0.45..1, clamped, so it rests at 0.45. -->
    <DataConverterRangeMapper minInput="0.5" maxInput="1" minOutput="0.45" maxOutput="1"
                              clampLower="true" clampUpper="true" name="TickPositive" id="0:120"/>
    <DataConverterRangeMapper minInput="-0.5" maxInput="-1" minOutput="0.45" maxOutput="1"
                              clampLower="true" clampUpper="true" name="TickNegative" id="0:121"/>
    <!-- A diagonal reads min() of its two axes (the bound source is stick/x;
         the second token reads stick/y, negated where the quadrant needs it),
         then the same 0.5..1 mapper. -->
    <DataConverterFormula name="MinXY" id="0:122">
        <FormulaTokenFunction functionType="0"/>
        <FormulaTokenInput/>
        <FormulaTokenArgumentSeparator/>
        <FormulaTokenValue><DataBindContext sourcePathIds="0:40-0:45-0:53" propertyKey="777"/></FormulaTokenValue>
        <FormulaTokenParenthesisClose/>
    </DataConverterFormula>
    <DataConverterFormula name="MinXNegY" id="0:123">
