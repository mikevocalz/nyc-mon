            <KeyedObject objectId="2:261"><KeyedProperty property="isDisabled"><KeyFrameBool value="false" interpolationType="hold"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Pressed" id="2:401">
            <KeyedObject objectId="2:240"><KeyedProperty property="opacity"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:243"><KeyedProperty property="colorValue"><KeyFrameColor value="FF4BA8F0" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:241"><KeyedProperty property="colorValue"><KeyFrameColor value="FF4BA8F0" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:222"><KeyedProperty property="colorValue"><KeyFrameColor value="FFFFFFFF" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:190"><KeyedProperty property="opacity"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:261"><KeyedProperty property="isDisabled"><KeyFrameBool value="false" interpolationType="hold"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Held" id="2:402">
            <KeyedObject objectId="2:240"><KeyedProperty property="opacity"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:243"><KeyedProperty property="colorValue"><KeyFrameColor value="FF4BA8F0" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:241"><KeyedProperty property="colorValue"><KeyFrameColor value="FF4BA8F0" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:222"><KeyedProperty property="colorValue"><KeyFrameColor value="FFFFFFFF" interpolationType="linear"/></KeyedProperty></KeyedObject>
