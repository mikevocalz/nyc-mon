        </LinearAnimation>
        <!-- Released: ring flash decays over 10 frames, ends on the idle pose -->
        <LinearAnimation duration="10" name="Released" id="2:403">
            <KeyedObject objectId="2:240"><KeyedProperty property="opacity">
                <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                <KeyFrameDouble value="0.45" frame="10" interpolationType="linear"/>
            </KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:243"><KeyedProperty property="colorValue">
                <KeyFrameColor value="FF4BA8F0" frame="0" interpolationType="linear"/>
                <KeyFrameColor value="FF4082FA" frame="10" interpolationType="linear"/>
            </KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:241"><KeyedProperty property="colorValue"><KeyFrameColor value="FF4082FA" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:222"><KeyedProperty property="colorValue"><KeyFrameColor value="FFDFE0E1" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:190"><KeyedProperty property="opacity"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:261"><KeyedProperty property="isDisabled"><KeyFrameBool value="false" interpolationType="hold"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <!-- ReleasedReduced: the authored reduced-motion sibling of Released.
             One frame on the idle pose: no flash, no decay. -->
        <LinearAnimation duration="1" name="ReleasedReduced" id="2:406">
            <KeyedObject objectId="2:240"><KeyedProperty property="opacity"><KeyFrameDouble value="0.45" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:243"><KeyedProperty property="colorValue"><KeyFrameColor value="FF4082FA" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:241"><KeyedProperty property="colorValue"><KeyFrameColor value="FF4082FA" interpolationType="linear"/></KeyedProperty></KeyedObject>
