    <!-- The button. 64 x 64, centred at 32,32: well and metal ring Ø56 (the
         cap of the ergonomics table), rings Ø50, cap face Ø44, 4 dp press depth. Bound to the Button view
         model; the pose layer follows `state`, the compression layer follows
         `state` and `reducedMotion` together. -->
    <Artboard isComponent="true" defaultStateMachineId="2:37" viewModelId="2:50" viewModelInstanceId="2:51"
              x="652" y="0" width="64" height="64" styleId="2:35" name="ArcadeButton" id="2:30">
        <LayoutComponentStyle name="Button Style" id="2:35"/>

        <Node x="32" y="32" name="Button" id="2:190">
            <!-- label on the cap, bound to Button.label -->
            <Text x="0" y="-1" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Label" id="2:220">
                <TextStylePaint fontSize="17" letterSpacing="0.5" fontAssetId="2:900" familyName="Space Grotesk" styleName="Bold" name="Label Style" id="2:221">
                    <Fill name="Fill"><SolidColor colorValue="FFDFE0E1" name="C" id="2:222"/></Fill>
                    <TextStyleAxis tag="2003265652" axisValue="700" name="Weight"/>
                </TextStylePaint>
                <TextValueRun styleId="2:221" text="A" name="Run">
                    <DataBindContext sourcePathIds="2:50-2:53" propertyKey="268"/>
                </TextValueRun>
            </Text>

            <!-- inset cap: convex, compresses on press -->
            <Node name="Cap" id="2:200">
                <Shape name="CapFace" id="2:201">
                    <Ellipse width="44" height="44" name="Path"/>
                    <Fill name="Fill">
                        <RadialGradient startX="-7" startY="-10" endX="22" endY="20" name="Dome">
                            <GradientStop colorValue="FF61656A" position="0"/>
                            <GradientStop colorValue="FF303337" position="0.55"/>
                            <GradientStop colorValue="FF1C1E21" position="1"/>
                        </RadialGradient>
                    </Fill>
                    <Stroke thickness="1.5" name="Rim"><SolidColor colorValue="FFB8BBBE" name="C" id="2:202"/></Stroke>
                </Shape>
                <Shape x="0" y="3" name="CapShadow" id="2:203">
                    <Ellipse width="46" height="46" name="Path"/>
                    <Fill fillRule="clockwise" name="Fill">
                        <SolidColor colorValue="B300041C" name="C"/>
                        <Feather strength="6" name="Soft"/>
                    </Fill>
                </Shape>
            </Node>

            <!-- illumination ring between cap and metal ring -->
            <Shape opacity="0.45" name="RingGlow" id="2:240">
                <Ellipse width="50" height="50" name="Path"/>
                <Stroke thickness="5" name="Glow">
                    <SolidColor colorValue="FF4082FA" name="C" id="2:241"/>
                    <Feather strength="10" name="Soft"/>
                </Stroke>
            </Shape>
            <Shape name="RingCrisp" id="2:242">
                <Ellipse width="50" height="50" name="Path"/>
                <Stroke thickness="2" name="Crisp"><SolidColor colorValue="FF4082FA" name="C" id="2:243"/></Stroke>
            </Shape>

            <!-- layered metallic ring -->
            <Shape name="MetalRing" id="2:250">
                <Ellipse width="56" height="56" name="Path"/>
                <Fill name="Fill">
                    <LinearGradient startX="0" startY="-28" endX="0" endY="28" name="Brushed">
                        <GradientStop colorValue="FFDFE0E1" position="0"/>
                        <GradientStop colorValue="FF7C8085" position="0.5"/>
                        <GradientStop colorValue="FF484C51" position="1"/>
                    </LinearGradient>
                </Fill>
                <Stroke thickness="1" name="Edge"><SolidColor colorValue="FF1C1E21" name="C"/></Stroke>
            </Shape>

            <!-- well: the semantic node and the pointer target. isDisabled is
                 keyed by the Pose timelines: true in disabled and cooldown.
                 Decision: BUILD cooldown as disabled to assistive tech (the
                 cap cannot fire); DEFER a held flag: SemanticData has no
                 pressed/held/busy state (`rive schema SemanticData`). -->
            <Shape name="Well" id="2:260">
                <SemanticData role="button" label="A" isEnablable="true" name="Semantics" id="2:261">
                    <DataBindContext sourcePathIds="2:50-2:53" propertyKey="983"/>
                    <DataBindContext sourcePathIds="2:50-2:54" propertyKey="984"/>
                </SemanticData>
                <Ellipse width="56" height="56" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF000000" name="C"/></Fill>
            </Shape>
        </Node>

        <Event name="buttonTap" id="2:300"/>

        <!-- Pose timelines, one hold key each. Keyed: ring glow opacity,
             ring colours, label colour, whole-button opacity. Rest ring is the
             royal-400 keyline; pressed and held light carolina-500; disabled
             and cooldown drop to concrete-700. -->
        <LinearAnimation duration="1" name="Idle" id="2:400">
            <KeyedObject objectId="2:240"><KeyedProperty property="opacity"><KeyFrameDouble value="0.45" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="2:243"><KeyedProperty property="colorValue"><KeyFrameColor value="FF4082FA" interpolationType="linear"/></KeyedProperty></KeyedObject>
