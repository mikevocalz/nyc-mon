            </Shape>
            <Text x="0" y="0" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Label" id="3:200">
                <TextStylePaint fontSize="13" letterSpacing="1" fontAssetId="2:900" familyName="Space Grotesk" styleName="Bold" name="Label Style" id="3:201">
                    <Fill name="Fill"><SolidColor colorValue="FF000000" name="C" id="3:202"/></Fill>
