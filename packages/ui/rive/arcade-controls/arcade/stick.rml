    <!-- Thumbpad: the cap alone, 72 x 72 (pad 56 plus an 8 dp shadow margin).
         The host draws it in its own view above the LeftStick artboard and
         moves that view with a Reanimated transform on the UI thread, so the
         pad tracks the finger at frame rate. Rive keeps the look: the dome,
         the highlight that counter-slides with stick/x and stick/y, and the
         engage compression. Bound to the same LeftStick view model, so one
         default instance drives both artboards. -->
    <Artboard defaultStateMachineId="1:707" viewModelId="1:40" viewModelInstanceId="1:41"
              x="200" y="0" width="72" height="72" styleId="1:705" name="Thumbpad" id="1:702">
        <LayoutComponentStyle name="Thumbpad Style" id="1:705"/>
        <Node x="36" y="36" name="Thumbpad" id="1:200">

            <!-- specular highlight slides opposite the tilt: perceived convexity -->
            <Shape x="-6" y="-7" name="Highlight" id="1:210">
                <DataBindContext sourcePathIds="1:40-1:45-1:52" propertyKey="13" converterId="1:116"/>
                <DataBindContext sourcePathIds="1:40-1:45-1:53" propertyKey="14" converterId="1:117"/>
                <Ellipse width="26" height="17" name="Path"/>
                <Fill fillRule="clockwise" name="Fill">
                    <SolidColor colorValue="66DFE0E1" name="C"/>
                    <Feather strength="7" name="Soft"/>
                </Fill>
            </Shape>

            <!-- convex cap: concrete-600 crown to concrete-800 face, concrete-900 edge -->
            <Shape name="Cap" id="1:205">
                <Ellipse width="56" height="56" name="Path"/>
                <Fill name="Fill">
                    <RadialGradient startX="-8" startY="-10" endX="27" endY="23" name="Dome">
                        <GradientStop colorValue="FF61656A" position="0"/>
                        <GradientStop colorValue="FF303337" position="0.55"/>
                        <GradientStop colorValue="FF1C1E21" position="1"/>
                    </RadialGradient>
                </Fill>
                <Stroke thickness="1.5" name="Rim" id="1:206">
                    <SolidColor colorValue="FFB8BBBE" name="C" id="1:207"/>
                </Stroke>
            </Shape>

            <!-- contact shadow under the cap -->
            <Shape x="0" y="4" name="Shadow" id="1:208">
                <Ellipse width="58" height="58" name="Path"/>
                <Fill fillRule="clockwise" name="Fill">
                    <SolidColor colorValue="B3000000" name="C"/>
                    <Feather strength="6" name="Soft"/>
                </Fill>
            </Shape>
        </Node>
        <LinearAnimation duration="1" name="PadIdle" id="1:720">
            <KeyedObject objectId="1:200">
                <KeyedProperty property="scaleX"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="1:207">
                <KeyedProperty property="colorValue"><KeyFrameColor value="FFB8BBBE" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="PadEngaged" id="1:721">
            <KeyedObject objectId="1:200">
                <KeyedProperty property="scaleX"><KeyFrameDouble value="0.94" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="0.94" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="1:207">
                <KeyedProperty property="colorValue"><KeyFrameColor value="FF4BA8F0" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="14" name="PadReleased" id="1:722">
            <KeyedObject objectId="1:200">
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="0.94" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.04" frame="6" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="14" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="0.94" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.04" frame="6" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="14" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="1:207">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="FF4BA8F0" frame="0" interpolationType="linear"/>
                    <KeyFrameColor value="FFB8BBBE" frame="14" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="PadEngagedReduced" id="1:723">
            <KeyedObject objectId="1:200">
                <KeyedProperty property="scaleX"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="1:207">
                <KeyedProperty property="colorValue"><KeyFrameColor value="FF4BA8F0" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <StateMachine name="Pad" id="1:707">
            <!-- Same Engage graph as the LeftStick machine, on the cap alone. -->
            <StateMachineLayer name="Engage" id="1:708">
                <AnyState x="700" y="-120"/>
                <ExitState x="900" y="-120"/>
                <EntryState x="0" y="0"><StateTransition stateToId="1:730"/></EntryState>
                <AnimationState x="160" y="0" animationId="1:720" id="1:730">
                    <StateTransition stateToId="1:731" duration="80">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="1:40-1:45-1:54" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="1:40-1:48-1:82" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="1:733" duration="0">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="1:40-1:45-1:54" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="1:40-1:48-1:82" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="360" y="-100" animationId="1:721" id="1:731">
                    <StateTransition stateToId="1:732" duration="0">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="1:40-1:45-1:54" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="560" y="0" animationId="1:722" reset="true" id="1:732">
                    <StateTransition stateToId="1:730" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                    <StateTransition stateToId="1:731" duration="80">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="1:40-1:45-1:54" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="360" y="100" animationId="1:723" id="1:733">
                    <StateTransition stateToId="1:730" duration="0">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="1:40-1:45-1:54" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- highlight counter-slides: light stays top-left as the pad tilts -->
    <DataConverterRangeMapper minInput="-1" maxInput="1" minOutput="-1" maxOutput="-11"
                              clampLower="true" clampUpper="true" name="HighlightX" id="1:116"/>
    <DataConverterRangeMapper minInput="-1" maxInput="1" minOutput="-12" maxOutput="-2"
                              clampLower="true" clampUpper="true" name="HighlightY" id="1:117"/>

    <!-- Indicator lighting. A cardinal tick reads its own axis: 0.5..1 of
         travel maps to opacity 0.45..1, clamped, so it rests at 0.45. -->
    <DataConverterRangeMapper minInput="0.5" maxInput="1" minOutput="0.45" maxOutput="1"
                              clampLower="true" clampUpper="true" name="TickPositive" id="1:120"/>
    <DataConverterRangeMapper minInput="-0.5" maxInput="-1" minOutput="0.45" maxOutput="1"
                              clampLower="true" clampUpper="true" name="TickNegative" id="1:121"/>
    <!-- A diagonal reads min() of its two axes (the bound source is stick/x;
         the second token reads stick/y, negated where the quadrant needs it),
         then the same 0.5..1 mapper. -->
    <DataConverterFormula name="MinXY" id="1:122">
        <FormulaTokenFunction functionType="0"/>
        <FormulaTokenInput/>
        <FormulaTokenArgumentSeparator/>
        <FormulaTokenValue><DataBindContext sourcePathIds="1:40-1:45-1:53" propertyKey="777"/></FormulaTokenValue>
        <FormulaTokenParenthesisClose/>
    </DataConverterFormula>
    <DataConverterFormula name="MinXNegY" id="1:123">
        <FormulaTokenFunction functionType="0"/>
        <FormulaTokenInput/>
        <FormulaTokenArgumentSeparator/>
        <FormulaTokenValue operationValue="0"/>
        <FormulaTokenOperation operationType="1"/>
        <FormulaTokenValue><DataBindContext sourcePathIds="1:40-1:45-1:53" propertyKey="777"/></FormulaTokenValue>
        <FormulaTokenParenthesisClose/>
    </DataConverterFormula>
    <DataConverterFormula name="MinNegXNegY" id="1:124">
        <FormulaTokenFunction functionType="0"/>
        <FormulaTokenValue operationValue="0"/>
        <FormulaTokenOperation operationType="1"/>
        <FormulaTokenInput/>
        <FormulaTokenArgumentSeparator/>
        <FormulaTokenValue operationValue="0"/>
        <FormulaTokenOperation operationType="1"/>
        <FormulaTokenValue><DataBindContext sourcePathIds="1:40-1:45-1:53" propertyKey="777"/></FormulaTokenValue>
        <FormulaTokenParenthesisClose/>
    </DataConverterFormula>
    <DataConverterFormula name="MinNegXY" id="1:125">
        <FormulaTokenFunction functionType="0"/>
        <FormulaTokenValue operationValue="0"/>
        <FormulaTokenOperation operationType="1"/>
        <FormulaTokenInput/>
        <FormulaTokenArgumentSeparator/>
        <FormulaTokenValue><DataBindContext sourcePathIds="1:40-1:45-1:53" propertyKey="777"/></FormulaTokenValue>
        <FormulaTokenParenthesisClose/>
    </DataConverterFormula>
