                    </ViewModelInstanceBoolean>
                </ViewModelInstance>
            </NestedArtboard>
            <!-- bottom row A B C, shifted 8 right -->
            <NestedArtboard artboardId="0:30" isStateful="true" x="-51.5" y="34" name="A" id="0:14">
                <NestedStateMachine animationId="0:37" name="Machine"/>
                <ViewModelInstance viewModelId="0:50" exports="true" name="A Instance" id="0:143">
                    <ViewModelInstanceEnum propertyValue="0:91" viewModelPropertyId="0:52"/>
                    <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:56">
                        <DataBindContext sourcePathIds="0:40-0:45-0:65-0:52" propertyKey="575" converterId="0:150"/>
                    </ViewModelInstanceNumber>
                    <ViewModelInstanceString propertyValue="A" viewModelPropertyId="0:53">
                        <DataBindContext sourcePathIds="0:40-0:45-0:65-0:53" propertyKey="561"/>
