<Rive version="1" kind="fragment">
    <!-- NYC-MON right six-button cluster (Master Directive v2 §2B, §8).
         One ArcadeButton component artboard placed six times. Each placement
         is a stateful nested artboard whose values are bound from the host's
         view model, so the host writes buttons/<id>/state, /label, /icon and
         a11y/reducedMotion and every cap follows (rive docs data:
         "Driving it from the parent instead").

         Geometry: the -45 degree cluster of packages/ui/game-controls/
         six-button-arch.ts (SIX_BUTTON_CENTRES_DP), scale 1.0, built from the
         rows of docs/design/research/arcade-ergonomics.md section 7 rotated
         -45 degrees so each row rises toward the upper right.
         Cap 56, cluster box 193 x 188, centres (x, y from the box's top-left):
           X (28, 121)  Y (66, 69)   Z (116, 28)
           A (77, 160)  B (116, 107) C (165, 66)
         Row frame: pitch 64 along a row, row pitch 62, bottom row slid 8
         along its row, the middle column the crest (+10) and the ring column
         +4. The artboard is 209 x 204: the 193 x 188 box plus an 8 dp glow
         margin on every side. The wrapper's hit region is the box; every
         centre below is offset by +8 and each 64 x 64 placement sits at
         (cx + 8 - 32, cy + 8 - 32), written relative to the Cluster shape at
         (104.5, 102). six-button-arch.test.ts parses these placements and
         fails if they drift from the TS table. Tokens and the
         per-state visuals are the G01 handoff's tables
         (docs/design/screens/G01-arcade-controller/08-handoff.md). -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" viewModelInstanceId="0:41"
              width="209" height="204" styleId="0:5" name="RightSix" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Focus host for the gamepad listeners: events bubble from the
             focused node (rive docs luau/protocols: "gamepad events bubble from
             the focused node upward"), so the cluster focuses itself on entry.
             Also the a11y group for the six buttons. -->
        <Shape x="104.5" y="102" name="Cluster" id="0:10">
            <FocusData canTouch="false" name="Focus"/>
            <SemanticData role="group" label="Action buttons" name="Semantics"/>
            <!-- a listener target has to be a Drawable; no paint, so it draws nothing -->
            <Rectangle width="209" height="204" name="Bounds"/>

            <!-- top row X Y Z. Placement = centre + 8 - 32, relative to the
                 cluster shape at (104.5, 102). -->
            <NestedArtboard artboardId="0:30" isStateful="true" x="-100.5" y="-5" name="X" id="0:11">
                <NestedStateMachine animationId="0:37" name="Machine"/>
                <ViewModelInstance viewModelId="0:50" exports="true" name="X Instance" id="0:140">
                    <ViewModelInstanceEnum propertyValue="0:91" viewModelPropertyId="0:52"/>
                    <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:56">
                        <DataBindContext sourcePathIds="0:40-0:45-0:62-0:52" propertyKey="575" converterId="0:150"/>
                    </ViewModelInstanceNumber>
                    <ViewModelInstanceString propertyValue="X" viewModelPropertyId="0:53">
                        <DataBindContext sourcePathIds="0:40-0:45-0:62-0:53" propertyKey="561"/>
                    </ViewModelInstanceString>
                    <ViewModelInstanceString propertyValue="" viewModelPropertyId="0:54">
                        <DataBindContext sourcePathIds="0:40-0:45-0:62-0:54" propertyKey="561"/>
                    </ViewModelInstanceString>
                    <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="0:55">
                        <DataBindContext sourcePathIds="0:40-0:48-0:102" propertyKey="593"/>
                    </ViewModelInstanceBoolean>
                </ViewModelInstance>
            </NestedArtboard>
            <NestedArtboard artboardId="0:30" isStateful="true" x="-62.5" y="-57" name="Y" id="0:12">
                <NestedStateMachine animationId="0:37" name="Machine"/>
                <ViewModelInstance viewModelId="0:50" exports="true" name="Y Instance" id="0:141">
                    <ViewModelInstanceEnum propertyValue="0:91" viewModelPropertyId="0:52"/>
