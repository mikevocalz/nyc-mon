                </ViewModelInstance>
            </NestedArtboard>
            <NestedArtboard artboardId="0:30" isStateful="true" x="-12.5" y="-98" name="Z" id="0:13">
                <NestedStateMachine animationId="0:37" name="Machine"/>
                <ViewModelInstance viewModelId="0:50" exports="true" name="Z Instance" id="0:142">
