                </ViewModelInstance>
            </NestedArtboard>
            <NestedArtboard artboardId="0:30" isStateful="true" x="-12.5" y="-19" name="B" id="0:15">
                <NestedStateMachine animationId="0:37" name="Machine"/>
                <ViewModelInstance viewModelId="0:50" exports="true" name="B Instance" id="0:144">
                    <ViewModelInstanceEnum propertyValue="0:91" viewModelPropertyId="0:52"/>
                    <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:56">
                        <DataBindContext sourcePathIds="0:40-0:45-0:66-0:52" propertyKey="575" converterId="0:150"/>
                    </ViewModelInstanceNumber>
                    <ViewModelInstanceString propertyValue="B" viewModelPropertyId="0:53">
                        <DataBindContext sourcePathIds="0:40-0:45-0:66-0:53" propertyKey="561"/>
                    </ViewModelInstanceString>
                    <ViewModelInstanceString propertyValue="" viewModelPropertyId="0:54">
                        <DataBindContext sourcePathIds="0:40-0:45-0:66-0:54" propertyKey="561"/>
                    </ViewModelInstanceString>
                    <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="0:55">
                        <DataBindContext sourcePathIds="0:40-0:48-0:102" propertyKey="593"/>
                    </ViewModelInstanceBoolean>
                </ViewModelInstance>
            </NestedArtboard>
            <NestedArtboard artboardId="0:30" isStateful="true" x="36.5" y="-60" name="C" id="0:16">
                <NestedStateMachine animationId="0:37" name="Machine"/>
                <ViewModelInstance viewModelId="0:50" exports="true" name="C Instance" id="0:145">
                    <ViewModelInstanceEnum propertyValue="0:91" viewModelPropertyId="0:52"/>
                    <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:56">
                        <DataBindContext sourcePathIds="0:40-0:45-0:67-0:52" propertyKey="575" converterId="0:150"/>
                    </ViewModelInstanceNumber>
                    <ViewModelInstanceString propertyValue="C" viewModelPropertyId="0:53">
                        <DataBindContext sourcePathIds="0:40-0:45-0:67-0:53" propertyKey="561"/>
                    </ViewModelInstanceString>
                    <ViewModelInstanceString propertyValue="" viewModelPropertyId="0:54">
                        <DataBindContext sourcePathIds="0:40-0:45-0:67-0:54" propertyKey="561"/>
                    </ViewModelInstanceString>
                    <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="0:55">
                        <DataBindContext sourcePathIds="0:40-0:48-0:102" propertyKey="593"/>
                    </ViewModelInstanceBoolean>
                </ViewModelInstance>
            </NestedArtboard>
        </Shape>

        <StateMachine name="Cluster" id="0:7">
            <!-- Gamepad listeners, CLI simulation only (§8). The slot-to-button
                 map is a test fixture, not a binding: south=a east=b west=x
                 north=y leftShoulder=z rightShoulder=c. Down writes pressed,
                 up writes released; the host writes idle after. -->
            <StateMachineListener targetId="0:10" name="Pad A Down" id="0:500">
                <ListenerInputTypeGamepad listenerTypeValue="gamepad">
                    <GamepadInput kind="button" mapping="standard" inputIndex="0" buttonPhase="1"/>
                </ListenerInputTypeGamepad>
                <ListenerViewModelChange><BindablePropertyEnum propertyValue="0:92"><DataBindContext sourcePathIds="0:40-0:45-0:65-0:52" propertyKey="637" direction="true"/></BindablePropertyEnum></ListenerViewModelChange>
            </StateMachineListener>
            <StateMachineListener targetId="0:10" name="Pad A Up" id="0:501">
                <ListenerInputTypeGamepad listenerTypeValue="gamepad">
                    <GamepadInput kind="button" mapping="standard" inputIndex="0" buttonPhase="2"/>
