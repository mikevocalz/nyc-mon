                    </ViewModelInstanceNumber>
                    <ViewModelInstanceString propertyValue="Z" viewModelPropertyId="0:53">
                        <DataBindContext sourcePathIds="0:40-0:45-0:64-0:53" propertyKey="561"/>
                    </ViewModelInstanceString>
                    <ViewModelInstanceString propertyValue="" viewModelPropertyId="0:54">
                        <DataBindContext sourcePathIds="0:40-0:45-0:64-0:54" propertyKey="561"/>
                    </ViewModelInstanceString>
                    <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="0:55">
