            <KeyedObject objectId="4:26"><KeyedProperty property="offset"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <!-- Theme timelines: plate, keyline, caption -->
        <LinearAnimation duration="1" name="Night" id="4:420">
            <KeyedObject objectId="4:12"><KeyedProperty property="colorValue"><KeyFrameColor value="FF00041C" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:22"><KeyedProperty property="colorValue"><KeyFrameColor value="FF0058F8" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:35"><KeyedProperty property="colorValue"><KeyFrameColor value="FFDFE0E1" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:62"><KeyedProperty property="colorValue"><KeyFrameColor value="FF00041C" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:66"><KeyedProperty property="colorValue"><KeyFrameColor value="FF00041C" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:63"><KeyedProperty property="colorValue"><KeyFrameColor value="FF0058F8" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:67"><KeyedProperty property="colorValue"><KeyFrameColor value="FF0058F8" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Daylit" id="4:421">
            <KeyedObject objectId="4:12"><KeyedProperty property="colorValue"><KeyFrameColor value="FFF3F4F4" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:22"><KeyedProperty property="colorValue"><KeyFrameColor value="FF3C1E00" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:35"><KeyedProperty property="colorValue"><KeyFrameColor value="FF61656A" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:62"><KeyedProperty property="colorValue"><KeyFrameColor value="FFF3F4F4" interpolationType="linear"/></KeyedProperty></KeyedObject>
