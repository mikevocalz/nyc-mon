    <FontAsset file="../../../../assets/fonts/SpaceGrotesk-Variable.ttf" name="Space Grotesk" id="4:901"/>

    <DataEnumCustom name="TransitionPhase" id="4:90">
        <DataEnumValue key="enter" value="Enter" id="4:91"/>
        <DataEnumValue key="hold" value="Hold" id="4:92"/>
        <DataEnumValue key="reveal" value="Reveal" id="4:93"/>
        <DataEnumValue key="done" value="Done" id="4:94"/>
    </DataEnumCustom>

    <!-- View models. Paths the host writes: transition/phase, theme/variant,
         layout/profile, a11y/reducedMotion. Theme, Layout and A11y come from
         shared-vm.rml (client 9), the file every lobby project links in. -->
    <ViewModel defaultInstanceId="4:54" name="Transition" id="4:50">
        <ViewModelPropertyEnumCustom enumId="4:90" name="phase" id="4:51"/>
        <ViewModelPropertyViewModel viewModelReferenceId="9:60" name="theme" id="4:52"/>
        <ViewModelPropertyViewModel viewModelReferenceId="9:80" name="a11y" id="4:53"/>
        <ViewModelInstance exports="true" name="Default" id="4:54">
