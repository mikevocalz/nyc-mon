        </LinearAnimation>
    </Artboard>

    <ComponentAsset artboardId="4:30" name="GameTransition"/>

    <!-- The host the CLI shows (rive.yaml main). It binds the root view model
         and hands the transition instance to the component through
         dataBindPathIds, which is the only way a nested artboard receives its
         data. game-lobby nests the same component from its own root. -->
    <Artboard defaultStateMachineId="4:7" viewModelId="4:40" viewModelInstanceId="4:41" x="1300" y="0"
              width="390" height="844" styleId="4:5" name="GameTransitionHost" id="4:2">
        <LayoutComponentStyle name="Host Style" id="4:5"/>
        <LayoutComponent width="390" height="844" styleId="4:17" name="Root" id="4:16">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill" name="Root Style" id="4:17"/>
            <NestedArtboardLayout artboardId="4:30" dataBindPathIds="4:40-4:45" instanceWidthScaleType="fill" instanceHeightScaleType="fill" name="Transition" id="4:18">
                <!-- without this the component's machine never runs: no fades, no trace, no theme -->
                <NestedStateMachine animationId="4:37" name="Machine"/>
            </NestedArtboardLayout>
        </LayoutComponent>
        <StateMachine name="Host" id="4:7">
            <StateMachineLayer name="L" id="4:8">
                <AnyState x="400" y="-120"/>
                <ExitState x="600" y="-120"/>
                <EntryState x="0" y="0"><StateTransition stateToId="4:19"/></EntryState>
                <AnimationState x="160" y="0" animationId="4:6" id="4:19"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="Rest" id="4:6"/>
    </Artboard>

