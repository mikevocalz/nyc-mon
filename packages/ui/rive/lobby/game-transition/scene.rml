<Rive version="1" kind="fragment">
    <!-- NYC-MON game transition (Master Directive v2 §3, G02 handoff § Motion).
         The opaque cover between the lobby and the first gameplay frame. The
         host owns transition/phase: enter when START resolves to a load, hold
         while the world builds, reveal once the resumed frame is ready, done
         after the cover has gone. Rive reflects the phase; it never advances
         it on its own, so an interrupted load can jump to done from any phase.
         Reduced motion is an authored sibling per phase (plain fades, no trace,
         no scale), chosen by a11y/reducedMotion on every transition.
         Ids use client 4: lobby/game-lobby symlinks this file beside its own.
         Colours are token hexes from packages/theme/tokens.ts (ARGB, no #). -->
    <Artboard isComponent="true" defaultStateMachineId="4:37" viewModelId="4:50" viewModelInstanceId="4:54"
              x="1800" y="0" width="390" height="844" styleId="4:29" name="GameTransition" id="4:30">
        <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill" name="Transition Style" id="4:29"/>

        <!-- Root fill box, then the cover: one fill box carrying the plate
             colour, padding 16 so the frame stays off the window edge at every
             viewport. -->
        <LayoutComponent width="390" height="844" styleId="4:11" name="Root" id="4:10">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill" name="Root Style" id="4:11"/>
            <!-- The cover proper. Opacity and scale are keyed here, one box below
                 the root: a key on the grafted root box itself is ignored when
                 the component is nested with NestedArtboardLayout. -->
            <LayoutComponent width="390" height="844" styleId="4:3" name="Cover" id="4:13">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill"
                                  flexDirectionValue="column" layoutAlignmentType="center"
                                  paddingLeft="16" paddingRight="16" paddingTop="16" paddingBottom="16"
                                  paddingLeftUnitsValue="points" paddingRightUnitsValue="points"
                                  paddingTopUnitsValue="points" paddingBottomUnitsValue="points"
                                  name="Cover Style" id="4:3"/>
            <Fill name="Plate"><SolidColor colorValue="FF00041C" name="C" id="4:12"/></Fill>

            <!-- Frame box: fills the padded area, draws the frame, centres the words -->
            <LayoutComponent width="358" height="812" styleId="4:15" name="FrameBox" id="4:14">
                <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill"
                                      flexDirectionValue="column" layoutAlignmentType="center"
                                      gapVertical="12" gapVerticalUnitsValue="points"
                                      name="FrameBox Style" id="4:15"/>

                <!-- perimeter: the frame box's own strokes, so they follow its
                     computed size at every viewport (a Shape path keeps its
                     drawn size under layout). Royal keyline plus the energy
                     trace, a short orange segment a TrimPath carries round the
                     outline. The two corner cuts below are small boxes pinned to
                     the corners: a plate-coloured triangle masks the frame's
                     corner and a diagonal keyline closes the cut. -->
                <Stroke thickness="2" join="round" name="Line"><SolidColor colorValue="FF0058F8" name="C" id="4:22"/></Stroke>
                <Stroke thickness="4" cap="round" join="round" name="Trace">
                    <SolidColor colorValue="FFFC7C00" name="C" id="4:25"/>
                    <TrimPath start="0" end="0.12" offset="0" name="Trim" id="4:26"/>
                </Stroke>
                <LayoutComponent width="28" height="28" styleId="4:61" name="CutTL" id="4:60">
                    <LayoutComponentStyle positionTypeValue="absolute" layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                          positionLeft="-2" positionTop="-2"
                                          positionLeftUnitsValue="points" positionTopUnitsValue="points"
                                          name="CutTL Style" id="4:61"/>
                    <Shape x="14" y="14" name="Mask">
                        <PointsPath isClosed="true" isClockwise="true" name="Path">
                            <StraightVertex x="-14" y="-14"/><StraightVertex x="14" y="-14"/><StraightVertex x="-14" y="14"/>
                        </PointsPath>
                        <Fill name="Fill"><SolidColor colorValue="FF00041C" name="C" id="4:62"/></Fill>
                    </Shape>
                    <Shape x="14" y="14" name="Cut">
                        <PointsPath isClosed="false" name="Path">
                            <StraightVertex x="-12" y="14"/><StraightVertex x="14" y="-12"/>
                        </PointsPath>
                        <Stroke thickness="2" cap="round" name="Line"><SolidColor colorValue="FF0058F8" name="C" id="4:63"/></Stroke>
                    </Shape>
                </LayoutComponent>
                <LayoutComponent width="28" height="28" styleId="4:65" name="CutBR" id="4:64">
                    <LayoutComponentStyle positionTypeValue="absolute" layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                          positionRight="-2" positionBottom="-2"
                                          positionRightUnitsValue="points" positionBottomUnitsValue="points"
                                          name="CutBR Style" id="4:65"/>
                    <Shape x="14" y="14" name="Mask">
                        <PointsPath isClosed="true" isClockwise="true" name="Path">
                            <StraightVertex x="14" y="14"/><StraightVertex x="-14" y="14"/><StraightVertex x="14" y="-14"/>
                        </PointsPath>
                        <Fill name="Fill"><SolidColor colorValue="FF00041C" name="C" id="4:66"/></Fill>
                    </Shape>
                    <Shape x="14" y="14" name="Cut">
                        <PointsPath isClosed="false" name="Path">
                            <StraightVertex x="-14" y="12"/><StraightVertex x="12" y="-14"/>
                        </PointsPath>
                        <Stroke thickness="2" cap="round" name="Line"><SolidColor colorValue="FF0058F8" name="C" id="4:67"/></Stroke>
                    </Shape>
                </LayoutComponent>

                <!-- wordmark and the loading line, hugged so the layout centres
                     them without stretching the glyphs -->
                <Text alignValue="center" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Wordmark" id="4:31">
                    <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="Participant"/>
                    <TextStylePaint fontSize="34" letterSpacing="1" fontAssetId="4:900" familyName="Archivo Black" styleName="Regular" name="Wordmark Style" id="4:32">
                        <Fill name="Fill"><SolidColor colorValue="FFFC7C00" name="C"/></Fill>
                    </TextStylePaint>
                    <TextValueRun styleId="4:32" text="NYC-MON" name="Run"/>
                </Text>
                <Text alignValue="center" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Caption" id="4:33">
                    <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="Participant"/>
                    <SemanticData role="text" label="Loading your game" isLiveRegion="true" name="Semantics"/>
                    <TextStylePaint fontSize="15" fontAssetId="4:901" familyName="Space Grotesk" styleName="Medium" name="Caption Style" id="4:34">
                        <Fill name="Fill"><SolidColor colorValue="FFDFE0E1" name="C" id="4:35"/></Fill>
                        <TextStyleAxis tag="2003265652" axisValue="500" name="Weight"/>
                    </TextStylePaint>
                    <TextValueRun styleId="4:34" text="Loading your game" name="Run"/>
                </Text>
            </LayoutComponent>
            </LayoutComponent>
        </LayoutComponent>

        <StateMachine name="Transition" id="4:37">
            <!-- Phase layer: four phases, each with a full and a reduced state.
                 Every state reaches every other on the enum, so the host can
                 jump to done mid-reveal (interrupted) and a reduced-motion
