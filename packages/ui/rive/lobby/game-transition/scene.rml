        <!-- Full-motion phase timelines. Keyed: Cover opacity and scale, the
             trace offset, the trace colour (alpha 00 is off). -->
        <LinearAnimation duration="18" name="Enter" id="4:400">
            <KeyedObject objectId="4:13">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="18" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="4:25"><KeyedProperty property="colorValue"><KeyFrameColor value="FFFC7C00" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:26"><KeyedProperty property="offset">
                <KeyFrameDouble value="0" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                <KeyFrameDouble value="0.25" frame="18" interpolationType="linear"/>
            </KeyedProperty></KeyedObject>
        </LinearAnimation>
        <!-- Hold: one trace pass round the perimeter every 72 frames, looping -->
        <LinearAnimation duration="72" loopValue="loop" name="Hold" id="4:401">
            <KeyedObject objectId="4:13">
                <KeyedProperty property="opacity"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleX"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="4:25"><KeyedProperty property="colorValue"><KeyFrameColor value="FFFC7C00" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:26"><KeyedProperty property="offset">
                <KeyFrameDouble value="0.25" frame="0" interpolationType="linear"/>
                <KeyFrameDouble value="1.25" frame="72" interpolationType="linear"/>
            </KeyedProperty></KeyedObject>
        </LinearAnimation>
        <!-- Reveal: the cover lifts away over 24 frames (400 ms), ease in -->
        <LinearAnimation duration="24" name="Reveal" id="4:402">
            <KeyedObject objectId="4:13">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="24" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.04" frame="24" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.04" frame="24" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="4:25"><KeyedProperty property="colorValue"><KeyFrameColor value="FFFC7C00" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:26"><KeyedProperty property="offset"><KeyFrameDouble value="0.25" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Done" id="4:403">
            <KeyedObject objectId="4:13">
                <KeyedProperty property="opacity"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleX"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="4:25"><KeyedProperty property="colorValue"><KeyFrameColor value="00FC7C00" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:26"><KeyedProperty property="offset"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <!-- Reduced-motion siblings: plain fades, no trace, no scale.
             tokens.ts motion-enter.reduced is a 200 ms fade (12 frames). -->
        <LinearAnimation duration="12" name="EnterReduced" id="4:410">
            <KeyedObject objectId="4:13">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="12" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
