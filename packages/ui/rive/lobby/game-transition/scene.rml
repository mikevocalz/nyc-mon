            </KeyedObject>
            <KeyedObject objectId="4:25"><KeyedProperty property="colorValue"><KeyFrameColor value="00FC7C00" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:26"><KeyedProperty property="offset"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="12" name="RevealReduced" id="4:412">
            <KeyedObject objectId="4:13">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="12" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="4:25"><KeyedProperty property="colorValue"><KeyFrameColor value="00FC7C00" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="4:26"><KeyedProperty property="offset"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="DoneReduced" id="4:413">
            <KeyedObject objectId="4:13">
                <KeyedProperty property="opacity"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleX"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
