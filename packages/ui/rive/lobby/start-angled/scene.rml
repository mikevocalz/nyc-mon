<Rive version="1" kind="fragment">
    <!-- NYC-MON angled START (Master Directive v2 §3, §8; G02 handoff).
         The top block is the resume status: the title follows
         lobby/resume/eligible, the district line follows lobby/resume/district.
         The button below is the kit's CornerCutFrame corner="all" shape (cuts
         on the top-left and bottom-right, packages/ui/neon/corner-cut.ts) in
         orange-500 with a black legend. lobby/start/state is the host's state;
         pressed, focused and activate are the control's own pointer, keyboard
         and screen-reader plumbing. Client id 3: the game-lobby project
         symlinks this file in beside its own, so ids must not collide.
         Colours are ARGB token hexes from packages/theme/tokens.ts. -->
    <Artboard defaultStateMachineId="3:17" viewModelId="3:40" viewModelInstanceId="3:41"
              x="0" y="400" width="343" height="128" styleId="3:5" name="StartAngledHost" id="3:2">
        <LayoutComponentStyle name="Artboard Style" id="3:5"/>
        <!-- The component receives the host's lobby instance through
             dataBindPathIds; a nested artboard gets no view model otherwise. -->
        <NestedArtboard artboardId="3:30" dataBindPathIds="3:40-3:42" x="0" y="0" name="Start" id="3:3">
            <NestedStateMachine animationId="3:7" name="Machine"/>
        </NestedArtboard>
        <StateMachine name="Host" id="3:17">
            <StateMachineLayer name="L" id="3:18">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="3:19"/></EntryState>
                <AnimationState x="200" animationId="3:16" id="3:19"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="Rest" id="3:16"/>
    </Artboard>

    <!-- The control. Bound to the Lobby view model, so game-lobby nests it the
         same way with its own root's lobby property. -->
    <Artboard isComponent="true" defaultStateMachineId="3:7" viewModelId="3:50" viewModelInstanceId="3:51"
              x="400" y="400" width="343" height="128" styleId="3:35" name="StartAngled" id="3:30">
        <LayoutComponentStyle name="Component Style" id="3:35"/>

        <!-- Resume status. Title keyed per eligibility; district bound. Neither
             text carries SemanticData: the button below speaks the title's
             sentence as its label and the district as its value.
             Decision: BUILD the district as the button's semantic value
             (finding L11); as its own text node it was an empty, 0 x 0 node
             whenever no district was set. -->
        <Text x="0" y="0" sizingValue="autoWidth" name="Title" id="3:100">
            <TextStylePaint fontSize="24" fontAssetId="3:900" familyName="Space Grotesk" styleName="Bold" name="Title Style" id="3:104">
                <Fill name="Fill"><SolidColor colorValue="FFF8F8F8" name="C" id="3:102"/></Fill>
                <TextStyleAxis tag="2003265652" axisValue="700" name="Weight"/>
            </TextStylePaint>
            <TextValueRun styleId="3:104" text="Start a new game" name="Run" id="3:103"/>
        </Text>
        <Text x="0" y="30" sizingValue="autoWidth" name="District" id="3:110">
            <TextStylePaint fontSize="15" fontAssetId="3:900" familyName="Space Grotesk" styleName="Regular" name="District Style" id="3:114">
                <Fill name="Fill"><SolidColor colorValue="FFBEC0C2" name="C" id="3:112"/></Fill>
                <TextStyleAxis tag="2003265652" axisValue="400" name="Weight"/>
            </TextStylePaint>
            <TextValueRun styleId="3:114" text="" name="Run" id="3:113">
                <DataBindContext sourcePathIds="3:50-3:45-3:62" propertyKey="268"/>
            </TextValueRun>
        </Text>

        <!-- Keyboard focus ring, outside the button so it does not compress. -->
        <Shape x="171.5" y="96" opacity="0" name="FocusRing" id="3:150">
            <PointsPath isClosed="true" isClockwise="true" name="Path">
                <StraightVertex x="-174.5" y="-10.2"/>
                <StraightVertex x="-149.7" y="-35"/>
                <StraightVertex x="174.5" y="-35"/>
                <StraightVertex x="174.5" y="10.2"/>
                <StraightVertex x="149.7" y="35"/>
                <StraightVertex x="-174.5" y="35"/>
            </PointsPath>
            <Stroke thickness="2" join="round" name="Ring"><SolidColor colorValue="FF4BA8F0" name="C"/></Stroke>
        </Shape>

        <!-- The button. Everything inside compresses on press. -->
        <Node x="171.5" y="96" name="Button" id="3:190">
            <Text x="0" y="0" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Legend" id="3:200">
                <TextStylePaint fontSize="14" letterSpacing="2.5" fontAssetId="3:900" familyName="Space Grotesk" styleName="Bold" name="Legend Style" id="3:201">
                    <Fill name="Fill"><SolidColor colorValue="FF000000" name="C" id="3:202"/></Fill>
                    <TextStyleAxis tag="2003265652" axisValue="700" name="Weight"/>
                </TextStylePaint>
                <TextValueRun styleId="3:201" text="START" name="Run" id="3:203"/>
            </Text>

            <!-- Energy trace: a trimmed segment that travels the outline. -->
            <Shape opacity="0" name="Trace" id="3:230">
                <PointsPath isClosed="true" isClockwise="true" name="Path">
                    <StraightVertex x="-171.5" y="-8"/>
                    <StraightVertex x="-147.5" y="-32"/>
                    <StraightVertex x="171.5" y="-32"/>
                    <StraightVertex x="171.5" y="8"/>
                    <StraightVertex x="147.5" y="32"/>
                    <StraightVertex x="-171.5" y="32"/>
                </PointsPath>
                <Stroke thickness="3" cap="round" join="round" name="Segment">
                    <SolidColor colorValue="FF4BA8F0" name="C"/>
                    <TrimPath start="0" end="0.18" offset="0" name="Trim" id="3:231"/>
                </Stroke>
            </Shape>

            <!-- Reduced-motion rim: steady, shown instead of the trace. -->
            <Shape opacity="0" name="ReducedRim" id="3:240">
                <PointsPath isClosed="true" isClockwise="true" name="Path">
                    <StraightVertex x="-171.5" y="-8"/>
                    <StraightVertex x="-147.5" y="-32"/>
                    <StraightVertex x="171.5" y="-32"/>
                    <StraightVertex x="171.5" y="8"/>
                    <StraightVertex x="147.5" y="32"/>
                    <StraightVertex x="-171.5" y="32"/>
                </PointsPath>
                <Stroke thickness="2" join="round" name="Rim"><SolidColor colorValue="FF4BA8F0" name="C" id="3:241"/></Stroke>
            </Shape>

            <!-- Structure keyline: feathered glow under a crisp 2 dp line. The
                 glow thickness swells on activate. Colour follows theme/variant. -->
            <Shape name="Keyline" id="3:220">
                <PointsPath isClosed="true" isClockwise="true" name="Path">
                    <StraightVertex x="-171.5" y="-8"/>
                    <StraightVertex x="-147.5" y="-32"/>
                    <StraightVertex x="171.5" y="-32"/>
                    <StraightVertex x="171.5" y="8"/>
                    <StraightVertex x="147.5" y="32"/>
                    <StraightVertex x="-171.5" y="32"/>
                </PointsPath>
                <Stroke thickness="4" join="round" name="Glow" id="3:221">
                    <SolidColor colorValue="FF0058F8" name="C" id="3:222"/>
                    <Feather strength="8" name="Soft"/>
                </Stroke>
                <Stroke thickness="2" join="round" name="Crisp">
                    <SolidColor colorValue="FF0058F8" name="C" id="3:223"/>
                </Stroke>
            </Shape>

            <!-- Press tint over the face: orange-400, keyed by the Press layer. -->
            <Shape opacity="0" name="PressTint" id="3:215">
                <PointsPath isClosed="true" isClockwise="true" name="Path">
                    <StraightVertex x="-171.5" y="-8"/>
                    <StraightVertex x="-147.5" y="-32"/>
                    <StraightVertex x="171.5" y="-32"/>
                    <StraightVertex x="171.5" y="8"/>
                    <StraightVertex x="147.5" y="32"/>
                    <StraightVertex x="-171.5" y="32"/>
                </PointsPath>
                <Fill name="Fill"><SolidColor colorValue="FFFD9D40" name="C"/></Fill>
            </Shape>

            <!-- Face: the control. Owns focus, semantics and every listener. -->
            <Shape name="Face" id="3:210">
                <FocusData name="Focus"/>
                <SemanticData role="button" label="Start a new game" hint="Starts the game" name="Semantics" id="3:211">
                    <DataBindContext sourcePathIds="3:50-3:45-3:62" propertyKey="984"/>
                </SemanticData>
                <PointsPath isClosed="true" isClockwise="true" name="Path">
                    <StraightVertex x="-171.5" y="-8"/>
                    <StraightVertex x="-147.5" y="-32"/>
                    <StraightVertex x="171.5" y="-32"/>
                    <StraightVertex x="171.5" y="8"/>
                    <StraightVertex x="147.5" y="32"/>
                    <StraightVertex x="-171.5" y="32"/>
                </PointsPath>
                <Fill name="Fill"><SolidColor colorValue="FFFC7C00" name="C" id="3:212"/></Fill>
            </Shape>
        </Node>

        <Event name="startActivated" id="3:300"/>

        <!-- Resume layer timelines: title text and the button's spoken name -->
        <LinearAnimation duration="1" name="NewGame" id="3:400">
            <KeyedObject objectId="3:103"><KeyedProperty property="text"><KeyFrameString value="Start a new game" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:211"><KeyedProperty property="label"><KeyFrameString value="Start a new game" interpolationType="hold"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Continue" id="3:401">
            <KeyedObject objectId="3:103"><KeyedProperty property="text"><KeyFrameString value="Continue your game" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:211"><KeyedProperty property="label"><KeyFrameString value="Continue your game" interpolationType="hold"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <!-- Theme layer timelines -->
        <LinearAnimation duration="1" name="Night" id="3:410">
            <KeyedObject objectId="3:102"><KeyedProperty property="colorValue"><KeyFrameColor value="FFF8F8F8" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:112"><KeyedProperty property="colorValue"><KeyFrameColor value="FFBEC0C2" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:222"><KeyedProperty property="colorValue"><KeyFrameColor value="FF0058F8" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:223"><KeyedProperty property="colorValue"><KeyFrameColor value="FF0058F8" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:241"><KeyedProperty property="colorValue"><KeyFrameColor value="FF4BA8F0" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Daylit" id="3:411">
            <KeyedObject objectId="3:102"><KeyedProperty property="colorValue"><KeyFrameColor value="FF000000" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:112"><KeyedProperty property="colorValue"><KeyFrameColor value="FF61656A" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:222"><KeyedProperty property="colorValue"><KeyFrameColor value="FF3C1E00" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:223"><KeyedProperty property="colorValue"><KeyFrameColor value="FF3C1E00" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:241"><KeyedProperty property="colorValue"><KeyFrameColor value="FF0058F8" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <!-- State layer timelines: face, legend, semantic disabled bit -->
        <LinearAnimation duration="1" name="Idle" id="3:420">
            <KeyedObject objectId="3:212"><KeyedProperty property="colorValue"><KeyFrameColor value="FFFC7C00" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:202"><KeyedProperty property="colorValue"><KeyFrameColor value="FF000000" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:211"><KeyedProperty property="isDisabled"><KeyFrameBool value="false" interpolationType="hold"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <!-- pressed, as the host states it: the orange-400 face -->
        <LinearAnimation duration="1" name="Pressed" id="3:421">
            <KeyedObject objectId="3:212"><KeyedProperty property="colorValue"><KeyFrameColor value="FFFD9D40" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:202"><KeyedProperty property="colorValue"><KeyFrameColor value="FF000000" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:211"><KeyedProperty property="isDisabled"><KeyFrameBool value="false" interpolationType="hold"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <!-- loading: the face holds the pressed shade so the change reads
             without motion; the trace loops in the Trace layer -->
        <LinearAnimation duration="1" name="Loading" id="3:422">
            <KeyedObject objectId="3:212"><KeyedProperty property="colorValue"><KeyFrameColor value="FFFD9D40" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:202"><KeyedProperty property="colorValue"><KeyFrameColor value="FF000000" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:211"><KeyedProperty property="isDisabled"><KeyFrameBool value="false" interpolationType="hold"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Disabled" id="3:423">
            <KeyedObject objectId="3:212"><KeyedProperty property="colorValue"><KeyFrameColor value="FF303337" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:202"><KeyedProperty property="colorValue"><KeyFrameColor value="FF484C51" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:211"><KeyedProperty property="isDisabled"><KeyFrameBool value="true" interpolationType="hold"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <!-- Trace layer timelines. TraceRun: one pass in 72 frames (1.2 s),
             then the segment is gone. Loop: the pass repeats while loading.
             Still / ReducedStill: nothing moves. -->
        <LinearAnimation duration="72" name="TraceRun" id="3:430">
            <KeyedObject objectId="3:230"><KeyedProperty property="opacity">
                <KeyFrameDouble value="1" frame="0" interpolationType="hold"/>
                <KeyFrameDouble value="1" frame="60" interpolationType="linear"/>
                <KeyFrameDouble value="0" frame="72" interpolationType="linear"/>
            </KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:231"><KeyedProperty property="offset">
                <KeyFrameDouble value="0" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
                <KeyFrameDouble value="1" frame="72" interpolationType="linear"/>
            </KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:240"><KeyedProperty property="opacity"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="72" loopValue="loop" name="TraceLoop" id="3:432">
            <KeyedObject objectId="3:230"><KeyedProperty property="opacity"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:231"><KeyedProperty property="offset">
                <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                <KeyFrameDouble value="1" frame="72" interpolationType="linear"/>
            </KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:240"><KeyedProperty property="opacity"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Still" id="3:431">
            <KeyedObject objectId="3:230"><KeyedProperty property="opacity"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:240"><KeyedProperty property="opacity"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <!-- reduced motion: no trace, a steady 2 dp rim instead -->
        <LinearAnimation duration="1" name="ReducedStill" id="3:433">
            <KeyedObject objectId="3:230"><KeyedProperty property="opacity"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="3:240"><KeyedProperty property="opacity"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <!-- Press layer timelines: compression, and its reduced sibling (tint only) -->
        <LinearAnimation duration="1" name="Rest" id="3:440">
            <KeyedObject objectId="3:190">
                <KeyedProperty property="scaleX"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="3:215"><KeyedProperty property="opacity"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Compressed" id="3:441">
            <KeyedObject objectId="3:190">
                <KeyedProperty property="scaleX"><KeyFrameDouble value="0.97" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="0.97" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="3:215"><KeyedProperty property="opacity"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="CompressedReduced" id="3:442">
            <KeyedObject objectId="3:190">
                <KeyedProperty property="scaleX"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="3:215"><KeyedProperty property="opacity"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <!-- Pulse layer timelines: the glow swells on activate (18 frames);
             the reduced sibling holds one brighter step for 12 frames. -->
        <LinearAnimation duration="1" name="GlowRest" id="3:450">
            <KeyedObject objectId="3:221"><KeyedProperty property="thickness"><KeyFrameDouble value="4" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="18" name="Pulse" id="3:451">
            <KeyedObject objectId="3:221"><KeyedProperty property="thickness">
                <KeyFrameDouble value="4" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                <KeyFrameDouble value="16" frame="6" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                <KeyFrameDouble value="4" frame="18" interpolationType="linear"/>
            </KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="12" name="PulseReduced" id="3:452">
            <KeyedObject objectId="3:221"><KeyedProperty property="thickness">
                <KeyFrameDouble value="10" frame="0" interpolationType="hold"/>
                <KeyFrameDouble value="4" frame="12" interpolationType="hold"/>
            </KeyedProperty></KeyedObject>
        </LinearAnimation>

        <!-- Focus layer timelines -->
        <LinearAnimation duration="1" name="Blurred" id="3:460">
            <KeyedObject objectId="3:150"><KeyedProperty property="opacity"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Focused" id="3:461">
            <KeyedObject objectId="3:150"><KeyedProperty property="opacity"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <StateMachine name="Start" id="3:7">
            <StateMachineListenerSingle targetId="3:210" listenerTypeValue="down" name="Face Down" id="3:500">
                <ListenerViewModelChange><BindablePropertyBoolean propertyValue="true"><DataBindContext sourcePathIds="3:50-3:46-3:67" propertyKey="634" direction="true"/></BindablePropertyBoolean></ListenerViewModelChange>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="3:210" listenerTypeValue="up" name="Face Up" id="3:501">
                <ListenerViewModelChange><BindablePropertyBoolean propertyValue="false"><DataBindContext sourcePathIds="3:50-3:46-3:67" propertyKey="634" direction="true"/></BindablePropertyBoolean></ListenerViewModelChange>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="3:210" listenerTypeValue="exit" name="Face Exit" id="3:502">
                <ListenerViewModelChange><BindablePropertyBoolean propertyValue="false"><DataBindContext sourcePathIds="3:50-3:46-3:67" propertyKey="634" direction="true"/></BindablePropertyBoolean></ListenerViewModelChange>
            </StateMachineListenerSingle>
            <!-- activate: click, enter/space, screen-reader tap -->
            <StateMachineListener targetId="3:210" name="Activate" id="3:503">
                <ListenerInputType listenerTypeValue="click"/>
                <ListenerInputTypeKeyboard listenerTypeValue="keyboard">
                    <KeyboardInput keyType="enter" keyPhase="1"/>
                    <KeyboardInput keyType="kpEnter" keyPhase="1"/>
                    <KeyboardInput keyType="space" keyPhase="1"/>
                </ListenerInputTypeKeyboard>
                <ListenerInputTypeSemantic listenerTypeValue="semanticAction">
                    <SemanticInput actionType="tap"/>
                </ListenerInputTypeSemantic>
                <ListenerFireEvent eventId="3:300"/>
                <ListenerViewModelChange>
                    <BindablePropertyTrigger propertyValue="1"><DataBindContext sourcePathIds="3:50-3:46-3:69" propertyKey="686" direction="true"/></BindablePropertyTrigger>
                </ListenerViewModelChange>
            </StateMachineListener>
            <!-- gamepad south (W3C 0) and start (9) on their own listener: grouped
                 with the input types above a gamepad trigger never fired in the
                 start-stop pill, alone it does -->
            <StateMachineListener targetId="3:210" name="Activate Pad" id="3:506">
                <ListenerInputTypeGamepad listenerTypeValue="gamepad">
                    <GamepadInput kind="button" mapping="standard" inputIndex="0" buttonPhase="1"/>
                    <GamepadInput kind="button" mapping="standard" inputIndex="9" buttonPhase="1"/>
                </ListenerInputTypeGamepad>
                <ListenerFireEvent eventId="3:300"/>
                <ListenerViewModelChange>
                    <BindablePropertyTrigger propertyValue="1"><DataBindContext sourcePathIds="3:50-3:46-3:69" propertyKey="686" direction="true"/></BindablePropertyTrigger>
                </ListenerViewModelChange>
            </StateMachineListener>
            <StateMachineListener targetId="3:210" name="Got Focus" id="3:504">
                <ListenerInputType listenerTypeValue="focus"/>
                <ListenerViewModelChange><BindablePropertyBoolean propertyValue="true"><DataBindContext sourcePathIds="3:50-3:46-3:68" propertyKey="634" direction="true"/></BindablePropertyBoolean></ListenerViewModelChange>
            </StateMachineListener>
            <StateMachineListener targetId="3:210" name="Lost Focus" id="3:505">
                <ListenerInputType listenerTypeValue="blur"/>
                <ListenerViewModelChange><BindablePropertyBoolean propertyValue="false"><DataBindContext sourcePathIds="3:50-3:46-3:68" propertyKey="634" direction="true"/></BindablePropertyBoolean></ListenerViewModelChange>
            </StateMachineListener>

            <!-- Resume layer: new game / continue, from lobby/resume/eligible -->
            <StateMachineLayer name="Resume" id="3:8">
                <AnyState x="500" y="-120"/>
                <ExitState x="700" y="-120"/>
                <EntryState x="0" y="0"><StateTransition stateToId="3:600"/></EntryState>
                <AnimationState x="160" y="0" animationId="3:400" id="3:600">
                    <StateTransition stateToId="3:601" duration="0">
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyBoolean><DataBindContext sourcePathIds="3:50-3:45-3:61" propertyKey="634"/></BindablePropertyBoolean></TransitionPropertyViewModelComparator><TransitionValueBooleanComparator value="true"/></TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="360" y="0" animationId="3:401" id="3:601">
                    <StateTransition stateToId="3:600" duration="0">
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyBoolean><DataBindContext sourcePathIds="3:50-3:45-3:61" propertyKey="634"/></BindablePropertyBoolean></TransitionPropertyViewModelComparator><TransitionValueBooleanComparator value="false"/></TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- Theme layer: night / daylit -->
            <StateMachineLayer name="Theme" id="3:9">
                <AnyState x="500" y="-120"/>
                <ExitState x="700" y="-120"/>
                <EntryState x="0" y="0"><StateTransition stateToId="3:610"/></EntryState>
                <AnimationState x="160" y="0" animationId="3:410" id="3:610">
                    <StateTransition stateToId="3:611" duration="0">
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="3:50-3:47-9:62" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="9:111"/></TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="360" y="0" animationId="3:411" id="3:611">
                    <StateTransition stateToId="3:610" duration="0">
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="3:50-3:47-9:62" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="9:112"/></TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- State layer: idle / pressed / loading / disabled, every state
                 reaches every other, conditioned on lobby/start/state -->
            <StateMachineLayer name="State" id="3:10">
                <AnyState x="900" y="-200"/>
                <ExitState x="1100" y="-200"/>
                <EntryState x="0" y="0"><StateTransition stateToId="3:620"/></EntryState>
                <AnimationState x="160" y="0" animationId="3:420" id="3:620">
                    <StateTransition stateToId="3:621" duration="0">
