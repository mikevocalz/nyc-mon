<Rive version="1" kind="fragment">
    <!-- NYC-MON game lobby, the assembled preview scene (Master Directive v2
         §3, §8; G02 handoff docs/design/screens/G02-game-lobby/08-handoff.md).
         Client id 1. This directory bundles four more markup files:
         shared-vm.rml (Theme, Layout, A11y, client 9) and three symlinks,
         leaderboard.rml, start-angled.rml and game-transition.rml, pointing at
         the sibling projects' scene.rml. The compiler reads every .rml in the
         directory as one document (rive docs project/rive-yaml), so the
         sibling component artboards nest here by id and never diverge from
         their own projects. Cross-project nesting through a published library
         needs `rive push`, which this session cannot run.

         Each nested component is handed its view model instance through
         dataBindPathIds from this root's property; a nested artboard with no
         handoff keeps its authored literals (proved by probe). The root's
         properties point at the siblings' default instances, so the contract
         paths read the same here as in each standalone project:
           lobby/resume/eligible, lobby/resume/district, lobby/start/state
           leaderboard/status, leaderboard/rows[n]/rank|name|score|isSelf
           transition/phase, theme/variant, layout/profile, a11y/reducedMotion

         Layout. One stack: the transition cover on top (declared first), the
         screen under it. The screen is a column: wordmark, then a body that
         holds the leaderboard panel and the START unit. The Profile layer keys
         the body's flex direction from layout/profile: column for
         phone-portrait, fold-outer, fold-tabletop, tablet and web; row for
         phone-landscape and fold-book (panel left, START right, nothing on a
         hinge). Decision: DEFER the tablet 56 rem content cap and safe-area
         insets to the RN wrapper, which sizes this artboard's view.

         The cover starts in its `enter` phase, so the lobby mounts covered and
         the host writes transition/phase=reveal once the data is bound, then
         `enter` again on START (G02 handoff § Motion). Captures pass
         transition/phase=done to see the lobby itself. -->
    <Artboard defaultStateMachineId="1:7" viewModelId="1:40" viewModelInstanceId="1:41"
              x="2400" y="0" width="390" height="844" styleId="1:5" name="GameLobby" id="1:2">
        <LayoutComponentStyle name="Artboard Style" id="1:5"/>

        <LayoutComponent styleId="1:11" name="Stack" id="1:10">
            <LayoutComponentStyle layoutTypeValue="stack" layoutWidthScaleType="fill" layoutHeightScaleType="fill" name="Stack Style" id="1:11"/>

            <!-- the loading cover, on top -->
            <NestedArtboardLayout artboardId="4:30" dataBindPathIds="1:40-1:47" instanceWidthScaleType="fill" instanceHeightScaleType="fill" name="Transition" id="1:12">
                <NestedStateMachine animationId="4:37" name="Machine"/>
            </NestedArtboardLayout>

            <!-- the screen -->
            <LayoutComponent styleId="1:21" name="Screen" id="1:20">
                <LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="fill" layoutHeightScaleType="fill"
                                      paddingLeft="16" paddingRight="16" paddingTop="24" paddingBottom="16"
                                      paddingLeftUnitsValue="points" paddingRightUnitsValue="points" paddingTopUnitsValue="points" paddingBottomUnitsValue="points"
                                      gapVertical="24" gapVerticalUnitsValue="points"
                                      name="Screen Style" id="1:21"/>
                <Fill name="Page"><SolidColor colorValue="FF00041C" name="C" id="1:22"/></Fill>

                <!-- identity: the wordmark as display type. Decision: BUILD text
                     here; the kit's BrandWordmark is the RN tree's h1 -->
                <Text name="Wordmark" id="1:30">
                    <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="Wordmark Layout"/>
                    <SemanticData role="text" label="NYC-MON" headingLevel="1" name="Semantics"/>
                    <TextStylePaint fontSize="28" fontAssetId="1:900" familyName="Archivo Black" styleName="Regular" name="Wordmark Style" id="1:31">
                        <Fill name="Fill"><SolidColor colorValue="FFFC7C00" name="C"/></Fill>
                    </TextStylePaint>
                    <TextValueRun styleId="1:31" text="NYC-MON" name="Run"/>
                </Text>

                <!-- body: panel then START; direction keyed by the Profile layer -->
                <LayoutComponent styleId="1:61" name="Body" id="1:60">
                    <LayoutComponentStyle flexDirectionValue="column" layoutAlignmentType="spaceBetweenStart"
                                          layoutWidthScaleType="fill" layoutHeightScaleType="fill"
                                          gapVertical="24" gapHorizontal="24" gapVerticalUnitsValue="points" gapHorizontalUnitsValue="points"
                                          name="Body Style" id="1:61"/>
                    <NestedArtboardLayout artboardId="2:30" dataBindPathIds="1:40-1:46" instanceWidth="343" instanceHeight="264" name="Leaderboard" id="1:62">
                        <NestedStateMachine animationId="2:37" name="Machine"/>
                    </NestedArtboardLayout>
                    <NestedArtboardLayout artboardId="3:30" dataBindPathIds="1:40-1:45" instanceWidth="343" instanceHeight="128" name="Start" id="1:63">
                        <NestedStateMachine animationId="3:7" name="Machine"/>
                    </NestedArtboardLayout>
                </LayoutComponent>
            </LayoutComponent>
        </LayoutComponent>

        <!-- Profile poses: the body's direction and alignment -->
        <LinearAnimation duration="1" name="Portrait" id="1:400">
            <KeyedObject objectId="1:61">
                <KeyedProperty property="flexDirectionValue"><KeyFrameUint value="0" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty property="layoutAlignmentType"><KeyFrameUint value="9" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Wide" id="1:401">
            <KeyedObject objectId="1:61">
                <KeyedProperty property="flexDirectionValue"><KeyFrameUint value="2" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty property="layoutAlignmentType"><KeyFrameUint value="10" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <!-- Theme poses: the page behind everything -->
        <LinearAnimation duration="1" name="Night" id="1:410">
            <KeyedObject objectId="1:22"><KeyedProperty property="colorValue"><KeyFrameColor value="FF00041C" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Daylit" id="1:411">
            <KeyedObject objectId="1:22"><KeyedProperty property="colorValue"><KeyFrameColor value="FFF3F4F4" interpolationType="linear"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <StateMachine name="Lobby" id="1:7">
            <StateMachineLayer name="Profile" id="1:8">
                <AnyState x="500" y="-120"/>
                <ExitState x="700" y="-120"/>
                <EntryState x="0" y="0"><StateTransition stateToId="1:600"/></EntryState>
                <AnimationState x="160" y="0" animationId="1:400" id="1:600">
                    <StateTransition stateToId="1:601" duration="0">
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="1:40-1:49-9:72" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="9:115"/></TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="1:601" duration="0">
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="1:40-1:49-9:72" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="9:117"/></TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="360" y="0" animationId="1:401" id="1:601">
                    <StateTransition stateToId="1:600" duration="0">
                        <TransitionViewModelCondition opValue="notEqual"><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="1:40-1:49-9:72" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="9:115"/></TransitionViewModelCondition>
                        <TransitionViewModelCondition opValue="notEqual"><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="1:40-1:49-9:72" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="9:117"/></TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
            <!-- Theme layer: a 200 ms page cross-fade, or an instant swap under
                 a11y/reducedMotion (finding L11; reduced motion is authored
                 here, not derived from the host). -->
            <StateMachineLayer name="Theme" id="1:9">
                <AnyState x="500" y="-120"/>
                <ExitState x="700" y="-120"/>
                <EntryState x="0" y="0"><StateTransition stateToId="1:610"/></EntryState>
                <AnimationState x="160" y="0" animationId="1:410" id="1:610">
                    <StateTransition stateToId="1:611" duration="200">
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="1:40-1:48-9:62" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="9:111"/></TransitionViewModelCondition>
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyBoolean><DataBindContext sourcePathIds="1:40-1:50-9:82" propertyKey="634"/></BindablePropertyBoolean></TransitionPropertyViewModelComparator><TransitionValueBooleanComparator value="false"/></TransitionViewModelCondition>
                    </StateTransition>
                    <!-- reduced motion: the same pose, instant -->
                    <StateTransition stateToId="1:611" duration="0">
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="1:40-1:48-9:62" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="9:111"/></TransitionViewModelCondition>
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyBoolean><DataBindContext sourcePathIds="1:40-1:50-9:82" propertyKey="634"/></BindablePropertyBoolean></TransitionPropertyViewModelComparator><TransitionValueBooleanComparator value="true"/></TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="360" y="0" animationId="1:411" id="1:611">
                    <StateTransition stateToId="1:610" duration="200">
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="1:40-1:48-9:62" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="9:112"/></TransitionViewModelCondition>
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyBoolean><DataBindContext sourcePathIds="1:40-1:50-9:82" propertyKey="634"/></BindablePropertyBoolean></TransitionPropertyViewModelComparator><TransitionValueBooleanComparator value="false"/></TransitionViewModelCondition>
                    </StateTransition>
                    <!-- reduced motion: the same pose, instant -->
                    <StateTransition stateToId="1:610" duration="0">
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="1:40-1:48-9:62" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="9:112"/></TransitionViewModelCondition>
                        <TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyBoolean><DataBindContext sourcePathIds="1:40-1:50-9:82" propertyKey="634"/></BindablePropertyBoolean></TransitionPropertyViewModelComparator><TransitionValueBooleanComparator value="true"/></TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <FontAsset file="../../../../assets/fonts/ArchivoBlack-Regular.ttf" name="Archivo Black" id="1:900"/>

    <!-- Root: every property points at the sibling projects' default
         instances (leaderboard 2:53, lobby 3:51, transition 4:54) and the
         shared theme / layout / a11y instances. -->
    <ViewModel defaultInstanceId="1:41" name="GameLobby" id="1:40">
        <ViewModelPropertyViewModel viewModelReferenceId="3:50" name="lobby" id="1:45"/>
