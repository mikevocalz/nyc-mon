    <!-- One row. 343 x 56, fixed on both axes so the list sizes rows from the
         artboard (rive docs data, "Laying the rows out"). Bound to Row. -->
    <Artboard isComponent="true" defaultStateMachineId="2:67" viewModelId="2:70" viewModelInstanceId="2:79"
