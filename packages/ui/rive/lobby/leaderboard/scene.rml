<Rive version="1" kind="fragment">
    <!-- NYC-MON lobby leaderboard (Master Directive v2 §3, §8; G02 handoff
         docs/design/screens/G02-game-lobby/08-handoff.md). Client id 2: this
         file is symlinked into lobby/game-lobby beside the other lobby
         projects, so no id here may collide with theirs. Theme, Layout and
         A11y view models come from shared-vm.rml (client 9).

         Two artboards. LeaderboardPanel is the component: it binds the Panel
         view model (status, rows, a11y) and is what game-lobby nests.
         Leaderboard is the standalone host: it binds the root view model so
         the contract paths leaderboard/status, leaderboard/rows[n]/rank,
         /name, /score, /isSelf and a11y/reducedMotion resolve from the top,
         and hands the panel its instance through dataBindPathIds. A nested
         artboard without that handoff keeps its authored literals (proved by
         probe in this session).

         Rows: ViewModelPropertyList "rows" on Panel, one ViewModelInstanceListItem
         per fixture row, LeaderboardRow (viewModelId = Row) repeated by an
         ArtboardComponentList bound with propertyKey 800 (rive docs data, "Lists
         and repeated artboards"). The CLI cannot set a row through --data
         (leaderboard/rows[0]/name reports no property at this path); the host
         runtime writes rows, and --data-dump proves the paths.

         Decision: BUILD a sixth status value, unavailable, on top of the
         directive's five, because the G02 handoff makes it the default until a
         ranking authority exists. Decision: STRIKE theme binding inside the
         panel; SolidPanel tone="ink" is the same ink in both schemes.
         Colours are tokens.ts hexes only (scripts/rive/check-colors.mjs). -->
    <Artboard defaultStateMachineId="2:7" viewModelId="2:40" viewModelInstanceId="2:41"
              width="343" height="264" styleId="2:5" name="Leaderboard" id="2:2">
        <LayoutComponentStyle name="Artboard Style" id="2:5"/>
        <!-- NestedStateMachine is required: without it the panel's machine never runs and every bind stays at its literal -->
        <NestedArtboard artboardId="2:30" dataBindPathIds="2:40-2:45" x="0" y="0" name="Panel" id="2:10">
            <NestedStateMachine animationId="2:37" name="Machine"/>
        </NestedArtboard>
        <StateMachine name="Host" id="2:7">
            <StateMachineLayer name="Host" id="2:8">
                <AnyState x="400" y="-120"/>
                <ExitState x="600" y="-120"/>
                <EntryState x="0" y="0"><StateTransition stateToId="2:20"/></EntryState>
                <AnimationState x="160" y="0" animationId="2:21" id="2:20"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="Rest" id="2:21"/>
    </Artboard>

    <!-- The panel. 343 x 264: header band 40, four 56 pt rows. Draw order is
         declaration order, first on top. -->
    <Artboard isComponent="true" defaultStateMachineId="2:37" viewModelId="2:50" viewModelInstanceId="2:53"
              x="400" y="0" width="343" height="264" styleId="2:35" name="LeaderboardPanel" id="2:30">
        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Panel Style" id="2:35"/>

        <!-- status line for empty / error / unavailable; a live region so a
             status change is announced once -->
        <Text x="16" y="64" opacity="0" sizingValue="autoWidth" name="Message" id="2:230">
            <SemanticData role="text" label="NYC Rank, ready" isLiveRegion="true" name="Semantics" id="2:265"/>
            <TextStylePaint fontSize="15" fontAssetId="2:900" familyName="Space Grotesk" styleName="Medium" name="Message Style" id="2:231">
                <Fill name="Fill"><SolidColor colorValue="FFDFE0E1" name="C"/></Fill>
                <TextStyleAxis tag="2003265652" axisValue="500" name="Weight"/>
            </TextStylePaint>
            <TextValueRun styleId="2:231" text="No ranks yet. Play a round to be ranked." name="Run" id="2:232"/>
        </Text>
        <!-- stale strip, bottom of the panel -->
        <Text x="327" y="20" originX="1" originY="0.5" alignValue="right" opacity="0" sizingValue="autoWidth" name="Strip" id="2:235">
            <TextStylePaint fontSize="13" fontAssetId="2:900" familyName="Space Grotesk" styleName="Medium" name="Strip Style" id="2:236">
                <Fill name="Fill"><SolidColor colorValue="FFFA4040" name="C"/></Fill>
                <TextStyleAxis tag="2003265652" axisValue="500" name="Weight"/>
            </TextStylePaint>
            <TextValueRun styleId="2:236" text="Rankings may be out of date." name="Run"/>
        </Text>

        <!-- loading skeleton: three lines, the full-motion timeline breathes
             them, the reduced sibling holds them still -->
        <Node opacity="0" name="Skeleton" id="2:220">
            <Shape x="16" y="63" name="Line 1" id="2:221"><Rectangle originX="0" originY="0" width="180" height="10" cornerRadiusTL="2" cornerRadiusTR="2" cornerRadiusBL="2" cornerRadiusBR="2" name="Path"/><Fill name="Fill"><SolidColor colorValue="FF484C51" name="C"/></Fill></Shape>
            <Shape x="16" y="119" name="Line 2" id="2:222"><Rectangle originX="0" originY="0" width="140" height="10" cornerRadiusTL="2" cornerRadiusTR="2" cornerRadiusBL="2" cornerRadiusBR="2" name="Path"/><Fill name="Fill"><SolidColor colorValue="FF484C51" name="C"/></Fill></Shape>
            <Shape x="16" y="175" name="Line 3" id="2:223"><Rectangle originX="0" originY="0" width="160" height="10" cornerRadiusTL="2" cornerRadiusTR="2" cornerRadiusBL="2" cornerRadiusBR="2" name="Path"/><Fill name="Fill"><SolidColor colorValue="FF484C51" name="C"/></Fill></Shape>
        </Node>

        <!-- the rows: a column of LeaderboardRow instances, one per list item -->
        <LayoutComponent x="0" y="40" width="343" height="224" styleId="2:241" name="Rows" id="2:240">
            <SemanticData role="list" label="NYC Rank" name="Semantics" id="2:266"/>
            <LayoutComponentStyle flexDirectionValue="column" layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Rows Style" id="2:241"/>
            <ArtboardComponentList name="List" id="2:242">
                <DataBindContext sourcePathIds="2:50-2:52" propertyKey="800"/>
            </ArtboardComponentList>
        </LayoutComponent>

        <!-- header: title, five lit segments, 2 dp royal keyline under the band -->
        <Text x="16" y="20" originY="0.5" sizingValue="autoWidth" name="Title" id="2:200">
            <SemanticData role="text" label="NYC Rank" headingLevel="2" name="Semantics"/>
            <TextStylePaint fontSize="14" letterSpacing="2.5" fontAssetId="2:900" familyName="Space Grotesk" styleName="SemiBold" name="Title Style" id="2:201">
                <Fill name="Fill"><SolidColor colorValue="FFF8F8F8" name="C"/></Fill>
                <TextStyleAxis tag="2003265652" axisValue="600" name="Weight"/>
            </TextStylePaint>
            <TextValueRun styleId="2:201" text="NYC RANK" name="Run"/>
        </Text>
        <Node name="Segments" id="2:209">
            <Shape x="245" y="20" opacity="0.25" name="Seg 1" id="2:210"><Rectangle width="12" height="6" name="Path"/><Fill name="Fill"><SolidColor colorValue="FF0058F8" name="C"/></Fill></Shape>
            <Shape x="263" y="20" opacity="0.25" name="Seg 2" id="2:211"><Rectangle width="12" height="6" name="Path"/><Fill name="Fill"><SolidColor colorValue="FF0058F8" name="C"/></Fill></Shape>
            <Shape x="281" y="20" opacity="0.25" name="Seg 3" id="2:212"><Rectangle width="12" height="6" name="Path"/><Fill name="Fill"><SolidColor colorValue="FF0058F8" name="C"/></Fill></Shape>
            <Shape x="299" y="20" opacity="0.25" name="Seg 4" id="2:213"><Rectangle width="12" height="6" name="Path"/><Fill name="Fill"><SolidColor colorValue="FF0058F8" name="C"/></Fill></Shape>
            <Shape x="317" y="20" opacity="0.25" name="Seg 5" id="2:214"><Rectangle width="12" height="6" name="Path"/><Fill name="Fill"><SolidColor colorValue="FFFC7C00" name="C"/></Fill></Shape>
        </Node>
        <Shape x="171.5" y="40" name="Header Rule" id="2:250">
            <Rectangle width="343" height="2" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF0058F8" name="C"/></Fill>
        </Shape>

        <!-- face and plate: the kit's SolidPanel tone="ink" inside a
             CornerCutFrame corner="bottom-right" cut 16 -->
        <Shape name="Face" id="2:251">
            <PointsPath isClosed="true" isClockwise="true" name="Path">
                <StraightVertex x="2" y="2"/>
                <StraightVertex x="341" y="2"/>
                <StraightVertex x="341" y="246.8"/>
                <StraightVertex x="325.8" y="262"/>
                <StraightVertex x="2" y="262"/>
            </PointsPath>
            <Fill name="Fill"><SolidColor colorValue="FF00041C" name="C"/></Fill>
        </Shape>
        <Shape name="Plate" id="2:252">
            <PointsPath isClosed="true" isClockwise="true" name="Path">
                <StraightVertex x="0" y="0"/>
                <StraightVertex x="343" y="0"/>
                <StraightVertex x="343" y="248"/>
                <StraightVertex x="327" y="264"/>
                <StraightVertex x="0" y="264"/>
            </PointsPath>
            <Fill name="Fill"><SolidColor colorValue="FF25293D" name="C"/></Fill>
