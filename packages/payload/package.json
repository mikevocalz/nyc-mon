{
  "name": "@acme/payload",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/payload.config.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./src/payload.config.ts"
    },
    "./config": {
      "types": "./src/payload.config.ts",
      "default": "./src/payload.config.ts"
    },
    "./admin/console/api": {
      "types": "./src/admin/console/api.ts",
      "default": "./src/admin/console/api.ts"
    },
    "./admin/console/features": {
      "types": "./src/admin/console/features.ts",
      "default": "./src/admin/console/features.ts"
    },
    "./admin/console/guardian-consent": {
      "types": "./src/admin/console/guardian-consent.ts",
      "default": "./src/admin/console/guardian-consent.ts"
    },
    "./admin/console/v1-game": {
      "types": "./src/admin/console/v1/game.ts",
      "default": "./src/admin/console/v1/game.ts"
    },
    "./admin/console/stores": {
      "types": "./src/admin/console/stores/index.ts",
      "default": "./src/admin/console/stores/index.ts"
    },
    "./admin/console/stores/*": {
      "types": "./src/admin/console/stores/*.ts",
      "default": "./src/admin/console/stores/*.ts"
    },
    "./auth/options": {
      "types": "./src/auth/options.ts",
      "default": "./src/auth/options.ts"
    },
    "./auth/templates": {
      "types": "./src/auth/templates.ts",
      "default": "./src/auth/templates.ts"
    },
    "./collections/core": {
      "types": "./src/collections/core.ts",
      "default": "./src/collections/core.ts"
    }
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@acme/content": "workspace:*",
    "@acme/core": "workspace:*",
    "@acme/ui": "workspace:*",
    "@aws-sdk/client-sns": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@delmaredigital/payload-better-auth": "catalog:",
    "@payloadcms/db-postgres": "catalog:",
    "@payloadcms/ui": "catalog:",
    "@vercel/functions": "catalog:",
    "better-auth": "catalog:",
    "payload": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "resend": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "eslint-config-expo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
