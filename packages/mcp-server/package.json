{
  "name": "@acme/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/mcp/tools.ts",
    "./schemas": "./src/mcp/schemas.ts",
    "./presence": "./src/presence/index.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/main.ts",
    "start": "node src/main.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@acme/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-expo": "catalog:",
    "typescript": "catalog:"
  }
}
