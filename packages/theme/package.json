{
  "name": "@acme/theme",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./theme.css": "./theme.css",
    "./theme-native.css": "./theme-native.css",
    "./switch": {
      "react-native": "./switch.native.ts",
      "default": "./switch.ts"
    }
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build": "node build-css.mjs",
    "test": "node --test '**/*.test.ts'"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-expo": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "type": "module"
}
